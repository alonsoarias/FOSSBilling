{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Dashboard'|trans }}{% endblock %}
{% block body_class %}page-dashboard{% endblock %}

{% import "macro_functions.html.twig" as mf %}

{% block content %}
{% if client %}
    {# Pending Ticket Alerts #}
    {% set pending_tickets = client.support_ticket_get_list({ "status": 'on_hold' }) %}
    {% if pending_tickets.total > 0 %}
        {% for ticket in pending_tickets.list %}
        <div class="alert alert-info d-flex align-items-center justify-content-between">
            <div>
                <i class="fa-solid fa-comment-dots me-2"></i>
                <span>{{ 'Ticket'|trans }} <strong>#{{ ticket.id }}</strong> {{ 'was replied to'|trans }} {{ ticket.updated_at|timeago }} {{ 'ago'|trans }}.</span>
            </div>
            <a href="{{ 'support/ticket'|link }}/{{ ticket.id }}" class="btn btn-sm btn-primary">
                <i class="fa-solid fa-reply me-1"></i>{{ 'Reply'|trans }}
            </a>
        </div>
        {% endfor %}
    {% endif %}

    {# Welcome Section #}
    <div class="mb-4">
        <h1 class="h3 mb-1">{{ 'Welcome back'|trans }}, {{ profile.first_name }}!</h1>
        <p class="text-muted mb-0">{{ 'Here is an overview of your account.'|trans }}</p>
    </div>

    {# Stats Grid #}
    {% set orders = client.order_get_list({ "hide_addons": 1 }) %}
    {% set active_orders = client.order_get_list({ "hide_addons": 1, "status": "active" }) %}
    {% set invoices = client.invoice_get_list() %}
    {% set unpaid_invoices = client.invoice_get_list({ "status": "unpaid" }) %}
    {% set tickets = client.support_ticket_get_list() %}
    {% set open_tickets = client.support_ticket_get_list({ "status": 'open' }) %}

    <div class="stat-grid">
        <a href="{{ 'order/service'|link }}" class="stat-card">
            <div class="stat-icon primary">
                <i class="fa-solid fa-server"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">{{ active_orders.total }}</div>
                <div class="stat-label">{{ 'Active Services'|trans }}</div>
            </div>
        </a>

        <a href="{{ 'invoice'|link }}" class="stat-card">
            <div class="stat-icon {% if unpaid_invoices.total > 0 %}warning{% else %}success{% endif %}">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">{{ unpaid_invoices.total }}</div>
                <div class="stat-label">{{ 'Unpaid Invoices'|trans }}</div>
            </div>
        </a>

        <a href="{{ 'support'|link }}" class="stat-card">
            <div class="stat-icon info">
                <i class="fa-solid fa-ticket"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">{{ open_tickets.total }}</div>
                <div class="stat-label">{{ 'Open Tickets'|trans }}</div>
            </div>
        </a>

        <a href="{{ 'client/balance'|link }}" class="stat-card">
            <div class="stat-icon success">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">{{ profile.balance | money(profile.currency) }}</div>
                <div class="stat-label">{{ 'Account Balance'|trans }}</div>
            </div>
        </a>
    </div>

    {# Content Row #}
    <div class="row">
        {# Recent Services #}
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="fa-solid fa-server me-2 text-muted"></i>
                        {{ 'Recent Services'|trans }}
                    </h5>
                    <a href="{{ 'order/service'|link }}" class="btn btn-sm btn-secondary">{{ 'View All'|trans }}</a>
                </div>
                {% set recent_orders = client.order_get_list({ "per_page": 5, "hide_addons": 1 }) %}
                {% if recent_orders.list %}
                <div class="card-body p-0">
                    {% for order in recent_orders.list %}
                    <a href="{{ 'order/service/manage'|link }}/{{ order.id }}" class="list-item">
                        <div class="list-item-icon bg-primary-light text-primary">
                            <i class="fa-solid fa-cube"></i>
                        </div>
                        <div class="list-item-content">
                            <div class="list-item-title">{{ order.title|truncate(40) }}</div>
                            <div class="list-item-meta">
                                #{{ order.id }} &middot; {{ order.updated_at|timeago }} {{ 'ago'|trans }}
                            </div>
                        </div>
                        <div class="list-item-action">
                            {{ mf.status_badge(order.status) }}
                        </div>
                    </a>
                    {% endfor %}
                </div>
                {% else %}
                <div class="card-body">
                    {{ mf.empty_state('server', 'No services yet'|trans, 'Order your first service to get started.'|trans, '/order'|link, 'Order Now'|trans) }}
                </div>
                {% endif %}
            </div>
        </div>

        {# Recent Tickets #}
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="fa-solid fa-ticket me-2 text-muted"></i>
                        {{ 'Support Tickets'|trans }}
                    </h5>
                    <a href="{{ 'support'|link({ 'ticket': 1 }) }}" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus me-1"></i>{{ 'New'|trans }}
                    </a>
                </div>
                {% set recent_tickets = client.support_ticket_get_list({ "per_page": 5 }) %}
                {% if recent_tickets.list %}
                <div class="card-body p-0">
                    {% for ticket in recent_tickets.list %}
                    <a href="{{ 'support/ticket'|link }}/{{ ticket.id }}" class="list-item">
                        <div class="list-item-icon bg-info-light text-info">
                            <i class="fa-solid fa-comment"></i>
                        </div>
                        <div class="list-item-content">
                            <div class="list-item-title">{{ ticket.subject|truncate(40) }}</div>
                            <div class="list-item-meta">
                                #{{ ticket.id }} &middot; {{ ticket.updated_at|timeago }} {{ 'ago'|trans }}
                            </div>
                        </div>
                        <div class="list-item-action">
                            {{ mf.status_badge(ticket.status) }}
                        </div>
                    </a>
                    {% endfor %}
                </div>
                {% else %}
                <div class="card-body">
                    {{ mf.empty_state('ticket', 'No tickets'|trans, 'Need help? Create a support ticket.'|trans, '/support'|link({ 'ticket': 1 }), 'Create Ticket'|trans) }}
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Recent Invoices #}
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">
                <i class="fa-solid fa-file-invoice-dollar me-2 text-muted"></i>
                {{ 'Recent Invoices'|trans }}
            </h5>
            <a href="{{ 'invoice'|link }}" class="btn btn-sm btn-secondary">{{ 'View All'|trans }}</a>
        </div>
        {% set recent_invoices = client.invoice_get_list({ "per_page": 5 }) %}
        {% if recent_invoices.list %}
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'Invoice'|trans }}</th>
                        <th>{{ 'Date'|trans }}</th>
                        <th>{{ 'Amount'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for invoice in recent_invoices.list %}
                    <tr>
                        <td><strong>#{{ invoice.id }}</strong></td>
                        <td>{{ invoice.created_at|format_date }}</td>
                        <td><strong>{{ invoice.total | money(invoice.currency) }}</strong></td>
                        <td>{{ mf.status_badge(invoice.status) }}</td>
                        <td class="text-end">
                            <a href="{{ 'invoice'|link }}/{{ invoice.hash }}" class="btn btn-sm btn-secondary">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            {% if invoice.status == 'unpaid' %}
                            <a href="{{ 'invoice'|link }}/{{ invoice.hash }}" class="btn btn-sm btn-primary">
                                {{ 'Pay'|trans }}
                            </a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="card-body">
            {{ mf.empty_state('file-invoice-dollar', 'No invoices'|trans, 'Your invoices will appear here.'|trans, null, null) }}
        </div>
        {% endif %}
    </div>

{% else %}
    {# Guest Dashboard #}
    <div class="text-center py-5">
        <div class="mb-4">
            <i class="fa-solid fa-user-circle fa-5x text-muted"></i>
        </div>
        <h2>{{ 'Welcome to'|trans }} {{ company.name }}</h2>
        <p class="text-muted mb-4">{{ 'Sign in to manage your services or create a new account.'|trans }}</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="{{ '/login'|link }}" class="btn btn-primary btn-lg">
                <i class="fa-solid fa-sign-in-alt me-2"></i>{{ 'Login'|trans }}
            </a>
            <a href="{{ '/signup'|link }}" class="btn btn-outline-primary btn-lg">
                <i class="fa-solid fa-user-plus me-2"></i>{{ 'Register'|trans }}
            </a>
        </div>
    </div>

    {# Quick Links for Guests #}
    <div class="stat-grid mt-5">
        <a href="{{ '/order'|link }}" class="stat-card">
            <div class="stat-icon primary">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label" style="font-size: 1rem; font-weight: 600; color: var(--gray-900);">{{ 'Products'|trans }}</div>
                <div class="stat-label">{{ 'Browse our catalog'|trans }}</div>
            </div>
        </a>

        {% if guest.extension_is_on({"mod":"news"}) %}
        <a href="{{ '/news'|link }}" class="stat-card">
            <div class="stat-icon info">
                <i class="fa-solid fa-newspaper"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label" style="font-size: 1rem; font-weight: 600; color: var(--gray-900);">{{ 'News'|trans }}</div>
                <div class="stat-label">{{ 'Latest updates'|trans }}</div>
            </div>
        </a>
        {% endif %}

        {% if guest.support_kb_enabled() %}
        <a href="{{ '/support/kb'|link }}" class="stat-card">
            <div class="stat-icon success">
                <i class="fa-solid fa-book"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label" style="font-size: 1rem; font-weight: 600; color: var(--gray-900);">{{ 'Knowledge Base'|trans }}</div>
                <div class="stat-label">{{ 'Tutorials and guides'|trans }}</div>
            </div>
        </a>
        {% endif %}

        <a href="{{ '/support'|link }}" class="stat-card">
            <div class="stat-icon warning">
                <i class="fa-solid fa-headset"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label" style="font-size: 1rem; font-weight: 600; color: var(--gray-900);">{{ 'Support'|trans }}</div>
                <div class="stat-label">{{ 'Get in touch'|trans }}</div>
            </div>
        </a>
    </div>
{% endif %}
{% endblock %}
