<div class="card">
    <div class="card-body">
        <div class="pricing-block">
            {% if pricing.type == 'free' %}
                {% if product.allow_quantity_select %}
                    <div class="mb-3">
                        <label class="form-label">{{ 'Cantidad:'|trans }}</label>
                        <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 80px;">
                    </div>
                {% endif %}

                <div class="total-price text-center py-3">
                    <div class="text-muted small mb-1">{{ 'Precio total:'|trans }}</div>
                    <div class="h2 mb-0 text-primary">{{ 0 | money_convert }}</div>
                </div>
            {% endif %}

            {% if pricing.type == 'once' %}
                {% if product.allow_quantity_select %}
                    <div class="mb-3">
                        <label class="form-label">{{ 'Cantidad:'|trans }}</label>
                        <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 80px;">
                    </div>
                {% endif %}

                <div class="total-price text-center py-3">
                    <div class="text-muted small mb-1">{{ 'Precio total:'|trans }}</div>
                    <div class="h2 mb-0 text-primary">{{ (pricing.once.price + pricing.once.setup) | money_convert }}</div>
                </div>
            {% endif %}

            {% if pricing.type == 'recurrent' %}
                {% if product.allow_quantity_select %}
                    <div class="mb-3">
                        <label class="form-label">{{ 'Cantidad:'|trans }}</label>
                        <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 80px;">
                    </div>
                {% endif %}

                <div class="mb-3">
                    <label class="form-label">{{ 'Ciclo de facturación:'|trans }}</label>
                    <select name="period" id="period-selector" class="form-select">
                        {% for code, prices in pricing.recurrent %}
                            {% if prices.enabled %}
                                <option value="{{ code }}"{% if request.period == code %} selected{% endif %}>{{ periods[code] }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                {% for code, prices in pricing.recurrent %}
                    {% if prices.enabled and prices.setup > 0 %}
                        <div class="period {{ code }} mb-3" style="display: none;">
                            <div class="d-flex justify-content-between small text-muted">
                                <span>{{ 'Precio'|trans }}</span>
                                <span>{{ prices.price | money_convert }}</span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>{{ 'Configuración'|trans }}</span>
                                <span>{{ prices.setup | money_convert }}</span>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="total-price text-center py-3 border-top">
                    <div class="text-muted small mb-1">{{ 'Precio total:'|trans }}</div>
                    {% for code, prices in pricing.recurrent %}
                        <div class="h2 mb-0 text-primary period {{ code }}">{{ (prices.price + prices.setup) | money_convert }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="d-grid">
            {% if product.addons|length > 0 %}
                <button class="btn btn-primary btn-lg" type="submit" id="order-button">
                    {{ 'Continuar'|trans }} <i class="fa fa-arrow-right ms-2"></i>
                </button>
            {% else %}
                <button class="btn btn-primary btn-lg" type="submit" id="order-button">
                    <i class="fa fa-shopping-cart me-2"></i> {{ 'Ordenar ahora'|trans }}
                </button>
            {% endif %}
        </div>
    </div>
</div>
