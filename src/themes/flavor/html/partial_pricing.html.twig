<div class="pricing-box">
    <div class="pricing-content">
        {% if pricing.type == 'free' %}
            {% if product.allow_quantity_select %}
            <div class="mb-3">
                <label class="form-label">{{ 'Quantity'|trans }}:</label>
                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 80px;">
            </div>
            {% endif %}

            <div class="pricing-total">
                <span class="total-label">{{ 'Total price'|trans }}:</span>
                <span class="total-price">{{ 0 | money_convert }}</span>
            </div>
        {% endif %}

        {% if pricing.type == 'once' %}
            {% if product.allow_quantity_select %}
            <div class="mb-3">
                <label class="form-label">{{ 'Quantity'|trans }}:</label>
                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 80px;">
            </div>
            {% endif %}

            <div class="pricing-total">
                <span class="total-label">{{ 'Total price'|trans }}:</span>
                <span class="total-price">{{ (pricing.once.price + pricing.once.setup) | money_convert }}</span>
            </div>
        {% endif %}

        {% if pricing.type == 'recurrent' %}
            {% if product.allow_quantity_select %}
            <div class="mb-3">
                <label class="form-label">{{ 'Quantity'|trans }}:</label>
                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 80px;">
            </div>
            {% endif %}

            <div class="mb-3">
                <label class="form-label">{{ 'Billing period'|trans }}:</label>
                <select name="period" id="period-selector" class="form-select">
                {% for code, prices in pricing.recurrent %}
                    {% if prices.enabled %}
                    <option value="{{ code }}"{% if request.period == code %} selected{% endif %}>{{ periods[code] }}</option>
                    {% endif %}
                {% endfor %}
                </select>
            </div>

            {% for code, prices in pricing.recurrent %}
                {% if prices.enabled and prices.setup > 0 %}
                <div class="period {{ code }} pricing-details" style="display: none;">
                    <table class="table table-sm">
                        <tr>
                            <td>{{ 'Price'|trans }}</td>
                            <td class="text-end">{{ prices.price | money_convert }}</td>
                        </tr>
                        <tr>
                            <td>{{ 'Setup Price'|trans }}</td>
                            <td class="text-end">{{ prices.setup | money_convert }}</td>
                        </tr>
                    </table>
                </div>
                {% endif %}
            {% endfor %}

            <div class="pricing-total">
                <span class="total-label">{{ 'Total price'|trans }}:</span>
                {% for code, prices in pricing.recurrent %}
                <span class="total-price period {{ code }}">{{ (prices.price + prices.setup) | money_convert }}</span>
                {% endfor %}
            </div>
        {% endif %}

        <div class="pricing-action mt-3">
            {% if product.addons|length > 0 %}
            <button class="btn btn-primary w-100" type="submit" id="order-button">
                <i class="fa-solid fa-arrow-right me-2"></i>{{ 'Continue'|trans }}
            </button>
            {% else %}
            <button class="btn btn-primary w-100" type="submit" id="order-button">
                <i class="fa-solid fa-cart-plus me-2"></i>{{ 'Order now'|trans }}
            </button>
            {% endif %}
        </div>
    </div>
</div>
