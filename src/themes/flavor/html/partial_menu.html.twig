{# Sidebar Navigation Menu #}
<nav class="sidebar-nav">
    {% if client %}
        {# Dashboard Section #}
        <div class="nav-section">
            <ul class="list-unstyled mb-0">
                <li class="nav-item">
                    <a class="nav-link {% if request_uri == '/' %}active{% endif %}" href="{{ '/'|link }}">
                        <i class="fa fa-home nav-icon"></i>
                        <span>{{ 'Dashboard'|trans }}</span>
                    </a>
                </li>
            </ul>
        </div>

        {# Services Section #}
        <div class="nav-section">
            <div class="nav-section-title">{{ 'Servicios'|trans }}</div>
            <ul class="list-unstyled mb-0">
                <li class="nav-item">
                    <a class="nav-link {% if '/order' in request_uri and '/orderhistory' not in request_uri %}active{% endif %}" href="{{ '/order'|link }}">
                        <i class="fa fa-shopping-cart nav-icon"></i>
                        <span>{{ 'Nuevo pedido'|trans }}</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if '/orderhistory' in request_uri %}active{% endif %}" href="{{ '/order/history'|link }}">
                        <i class="fa fa-list nav-icon"></i>
                        <span>{{ 'Mis pedidos'|trans }}</span>
                        {% set orders_count = client.order_get_list({'per_page': 1, 'status': 'active'}).total %}
                        {% if orders_count > 0 %}
                            <span class="badge bg-primary">{{ orders_count }}</span>
                        {% endif %}
                    </a>
                </li>
            </ul>
        </div>

        {# Billing Section #}
        <div class="nav-section">
            <div class="nav-section-title">{{ 'Facturación'|trans }}</div>
            <ul class="list-unstyled mb-0">
                <li class="nav-item">
                    <a class="nav-link {% if '/invoice' in request_uri %}active{% endif %}" href="{{ '/invoice'|link }}">
                        <i class="fa fa-file-text-o nav-icon"></i>
                        <span>{{ 'Facturas'|trans }}</span>
                        {% set unpaid_count = client.invoice_get_list({'per_page': 1, 'status': 'unpaid'}).total %}
                        {% if unpaid_count > 0 %}
                            <span class="badge bg-warning">{{ unpaid_count }}</span>
                        {% endif %}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if '/balance' in request_uri %}active{% endif %}" href="{{ '/client/balance'|link }}">
                        <i class="fa fa-credit-card nav-icon"></i>
                        <span>{{ 'Saldo'|trans }}</span>
                    </a>
                </li>
            </ul>
        </div>

        {# Support Section #}
        <div class="nav-section">
            <div class="nav-section-title">{{ 'Soporte'|trans }}</div>
            <ul class="list-unstyled mb-0">
                <li class="nav-item">
                    <a class="nav-link {% if '/support' in request_uri and '/supportkb' not in request_uri %}active{% endif %}" href="{{ '/support'|link }}">
                        <i class="fa fa-life-ring nav-icon"></i>
                        <span>{{ 'Tickets'|trans }}</span>
                        {% set open_tickets = client.support_ticket_get_list({'per_page': 1, 'status': 'open'}).total %}
                        {% if open_tickets > 0 %}
                            <span class="badge bg-info">{{ open_tickets }}</span>
                        {% endif %}
                    </a>
                </li>
                {% if guest.extension_is_on({"mod":"kb"}) %}
                    <li class="nav-item">
                        <a class="nav-link {% if '/supportkb' in request_uri %}active{% endif %}" href="{{ '/support/kb'|link }}">
                            <i class="fa fa-book nav-icon"></i>
                            <span>{{ 'Base de conocimiento'|trans }}</span>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>

        {# Account Section #}
        <div class="nav-section">
            <div class="nav-section-title">{{ 'Cuenta'|trans }}</div>
            <ul class="list-unstyled mb-0">
                <li class="nav-item">
                    <a class="nav-link {% if '/profile' in request_uri %}active{% endif %}" href="{{ '/client/profile'|link }}">
                        <i class="fa fa-user nav-icon"></i>
                        <span>{{ 'Perfil'|trans }}</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if '/email' in request_uri %}active{% endif %}" href="{{ '/client/email'|link }}">
                        <i class="fa fa-envelope nav-icon"></i>
                        <span>{{ 'Correos'|trans }}</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-danger" href="{{ '/client/logout'|link }}">
                        <i class="fa fa-sign-out nav-icon"></i>
                        <span>{{ 'Cerrar sesión'|trans }}</span>
                    </a>
                </li>
            </ul>
        </div>
    {% else %}
        {# Guest Menu #}
        <div class="nav-section">
            <ul class="list-unstyled mb-0">
                <li class="nav-item">
                    <a class="nav-link" href="{{ '/order'|link }}">
                        <i class="fa fa-shopping-cart nav-icon"></i>
                        <span>{{ 'Productos'|trans }}</span>
                    </a>
                </li>
                {% if guest.extension_is_on({"mod":"kb"}) %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ '/support/kb'|link }}">
                            <i class="fa fa-book nav-icon"></i>
                            <span>{{ 'Base de conocimiento'|trans }}</span>
                        </a>
                    </li>
                {% endif %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ '/login'|link }}">
                        <i class="fa fa-sign-in nav-icon"></i>
                        <span>{{ 'Iniciar sesión'|trans }}</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ '/signup'|link }}">
                        <i class="fa fa-user-plus nav-icon"></i>
                        <span>{{ 'Registrarse'|trans }}</span>
                    </a>
                </li>
            </ul>
        </div>
    {% endif %}
</nav>
