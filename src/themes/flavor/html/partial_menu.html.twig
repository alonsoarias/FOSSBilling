{% if settings.side_menu_dashboard %}
<a class="nav-link {% if request.uri == '/' %}active{% endif %}" href="{{ '/'|link }}">
    <i class="fa-solid fa-gauge-high"></i>
    {{ 'Dashboard'|trans }}
</a>
{% endif %}

{% if settings.side_menu_order %}
<a class="nav-link {% if '/order' in request.uri and '/order/service' not in request.uri %}active{% endif %}" href="{{ '/order'|link }}">
    <i class="fa-solid fa-cart-shopping"></i>
    {{ 'Order'|trans }}
</a>
{% endif %}

{% if settings.side_menu_services %}
<a class="nav-link {% if '/order/service' in request.uri %}active{% endif %}" href="{{ '/order/service'|link }}">
    <i class="fa-solid fa-server"></i>
    {{ 'Services'|trans }}
</a>
{% endif %}

{% if settings.side_menu_support %}
<a class="nav-link {% if '/support' in request.uri and '/support/kb' not in request.uri %}active{% endif %}" href="{{ '/support'|link }}">
    <i class="fa-solid fa-headset"></i>
    {{ 'Support'|trans }}
</a>
{% endif %}

{% if settings.side_menu_invoices %}
<a class="nav-link {% if '/invoice' in request.uri %}active{% endif %}" href="{{ '/invoice'|link }}">
    <i class="fa-solid fa-file-invoice-dollar"></i>
    {{ 'Invoices'|trans }}
</a>
{% endif %}

{% if settings.side_menu_emails %}
<a class="nav-link {% if '/email' in request.uri %}active{% endif %}" href="{{ '/email'|link }}">
    <i class="fa-solid fa-envelope"></i>
    {{ 'Email'|trans }}
</a>
{% endif %}

{% if settings.side_menu_payments %}
<a class="nav-link {% if '/client/balance' in request.uri %}active{% endif %}" href="{{ '/client/balance'|link }}">
    <i class="fa-solid fa-wallet"></i>
    {{ 'Wallet'|trans }}
</a>
{% endif %}

{% if guest.extension_is_on({"mod":"news"}) and settings.side_menu_news %}
<a class="nav-link {% if '/news' in request.uri %}active{% endif %}" href="{{ '/news'|link }}">
    <i class="fa-solid fa-newspaper"></i>
    {{ 'News'|trans }}
</a>
{% endif %}

{% if guest.support_kb_enabled() and settings.side_menu_kb %}
<a class="nav-link {% if '/support/kb' in request.uri %}active{% endif %}" href="{{ 'support/kb'|link }}">
    <i class="fa-solid fa-book"></i>
    {{ 'Knowledge Base'|trans }}
</a>
{% endif %}
