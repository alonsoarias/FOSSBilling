<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ settings.theme|default('light') }}">
<head>
    <meta charset="utf-8">
    <title>{% block meta_title %}{% endblock %} - {{ guest.system_company.name }}</title>

    <meta property="bb:url" content="{{ constant('SYSTEM_URL') }}">
    <meta property="bb:client_area" content="{{ '/'|link }}">
    <meta name="csrf-token" content="{{ CSRFToken }}">

    <meta name="description" content="{% block meta_description %}{{ settings.meta_description }}{% endblock %}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="FOSSBilling">

    {% block opengraph %}{% endblock %}

    <!-- Favicon -->
    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Flag Icons -->
    <link href="https://cdn.jsdelivr.net/npm/flag-icons@7.1.0/css/flag-icons.min.css" rel="stylesheet">

    <!-- Theme CSS -->
    <link rel="stylesheet" href="{{ 'css/flavor.css' | asset_url }}">

    <!-- API -->
    {{ "Api/API.js" | library_url | script_tag }}

    {{ DebugBar_renderHead() }}

    {% block head %}{% endblock %}
</head>

<body class="{% block body_class %}{% endblock %}">
{% block body %}

{# Load client profile if logged in #}
{% if client %}
    {% set profile = client.profile_get %}
{% endif %}
{% set company = guest.system_company %}

{# Check for require login setting #}
{% if not client and settings.require_login %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const publicPaths = ['/news', '/tos', '/privacy-policy', '/login', '/signup', '/password-reset', '/order'];
        const currentPath = window.location.pathname;
        const isAllowed = publicPaths.some(path => currentPath.startsWith(path));
        if (!isAllowed) {
            window.location.href = '{{ "login"|link }}';
        }
    });
</script>
{% endif %}

<div class="app">
    <!-- Header -->
    <header class="app-header">
        <div class="container-xl">
            <div class="header-content">
                <!-- Logo -->
                <a href="{{ '/'|link }}" class="header-brand">
                    {% if company.logo_url and settings.show_company_logo %}
                        <img src="{{ settings.theme == 'dark' ? company.logo_url_dark : company.logo_url }}" alt="{{ company.name }}" class="header-logo">
                    {% else %}
                        <span class="header-brand-text">{{ company.name }}</span>
                    {% endif %}
                </a>

                <!-- Desktop Navigation -->
                <nav class="header-nav d-none d-lg-flex">
                    <a href="{{ '/'|link }}" class="nav-link {% if request.uri == '/' %}active{% endif %}">
                        <i class="fa-solid fa-house"></i>
                        <span>{{ 'Dashboard'|trans }}</span>
                    </a>
                    <a href="{{ '/order/service'|link }}" class="nav-link {% if '/order/service' in request.uri %}active{% endif %}">
                        <i class="fa-solid fa-server"></i>
                        <span>{{ 'Services'|trans }}</span>
                    </a>
                    <a href="{{ '/invoice'|link }}" class="nav-link {% if '/invoice' in request.uri %}active{% endif %}">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <span>{{ 'Billing'|trans }}</span>
                    </a>
                    <a href="{{ '/support'|link }}" class="nav-link {% if '/support' in request.uri %}active{% endif %}">
                        <i class="fa-solid fa-headset"></i>
                        <span>{{ 'Support'|trans }}</span>
                    </a>
                    {% if guest.extension_is_on({"mod":"news"}) %}
                    <a href="{{ '/news'|link }}" class="nav-link {% if '/news' in request.uri %}active{% endif %}">
                        <i class="fa-solid fa-newspaper"></i>
                        <span>{{ 'News'|trans }}</span>
                    </a>
                    {% endif %}
                </nav>

                <!-- Header Actions -->
                <div class="header-actions">
                    <!-- Language Selector -->
                    {% set languages = guest.extension_languages(true) %}
                    {% if languages|length > 1 %}
                    <div class="dropdown d-none d-md-block">
                        <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ 'Language'|trans }}">
                            <i class="fa-solid fa-globe"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% for lang in languages %}
                            <li>
                                <a class="dropdown-item lang-item" href="#" data-lang="{{ lang.locale }}">
                                    <span class="fi fi-{{ lang.locale|split('_')[1]|lower }}"></span>
                                    {{ lang.title }}
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    {% if client %}
                        <!-- New Order Button -->
                        <a href="{{ '/order'|link }}" class="btn btn-primary d-none d-md-inline-flex">
                            <i class="fa-solid fa-plus me-2"></i>
                            {{ 'New Order'|trans }}
                        </a>

                        <!-- User Menu -->
                        <div class="dropdown">
                            <button class="btn-user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="{{ profile.email|gravatar(80) }}" alt="{{ profile.first_name }}" class="user-avatar">
                                <div class="user-info d-none d-md-block">
                                    <span class="user-name">{{ profile.first_name }}</span>
                                    <span class="user-balance">{{ profile.balance | money(profile.currency) }}</span>
                                </div>
                                <i class="fa-solid fa-chevron-down ms-2 d-none d-md-block"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                                <li class="dropdown-header">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="{{ profile.email|gravatar(80) }}" alt="{{ profile.first_name }}" class="user-avatar-lg">
                                        <div>
                                            <div class="fw-semibold">{{ profile.first_name }} {{ profile.last_name }}</div>
                                            <div class="text-muted small">{{ profile.email }}</div>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-item-balance">
                                    <span class="text-muted">{{ 'Balance'|trans }}</span>
                                    <span class="balance-amount">{{ profile.balance | money(profile.currency) }}</span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ 'client/profile'|link }}"><i class="fa-solid fa-user me-2"></i>{{ 'Profile'|trans }}</a></li>
                                <li><a class="dropdown-item" href="{{ 'client/balance'|link }}"><i class="fa-solid fa-wallet me-2"></i>{{ 'Wallet'|trans }}</a></li>
                                <li><a class="dropdown-item" href="{{ '/email'|link }}"><i class="fa-solid fa-envelope me-2"></i>{{ 'Emails'|trans }}</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ 'client/logout'|link }}"><i class="fa-solid fa-right-from-bracket me-2"></i>{{ 'Sign Out'|trans }}</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <!-- Login/Register for guests -->
                        <a href="{{ '/login'|link }}" class="btn btn-outline-primary d-none d-md-inline-flex">{{ 'Login'|trans }}</a>
                        <a href="{{ '/signup'|link }}" class="btn btn-primary d-none d-md-inline-flex">{{ 'Register'|trans }}</a>
                    {% endif %}

                    <!-- Mobile Menu Toggle -->
                    <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu Offcanvas -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            {% if client %}
            <div class="d-flex align-items-center gap-3">
                <img src="{{ profile.email|gravatar(80) }}" alt="{{ profile.first_name }}" class="user-avatar-lg">
                <div>
                    <div class="fw-semibold">{{ profile.first_name }} {{ profile.last_name }}</div>
                    <div class="text-muted small">{{ profile.balance | money(profile.currency) }}</div>
                </div>
            </div>
            {% else %}
            <span class="offcanvas-title" id="mobileMenuLabel">{{ 'Menu'|trans }}</span>
            {% endif %}
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <nav class="mobile-nav">
                <a href="{{ '/'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-house"></i>
                    {{ 'Dashboard'|trans }}
                </a>
                <a href="{{ '/order/service'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-server"></i>
                    {{ 'Services'|trans }}
                </a>
                <a href="{{ '/invoice'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    {{ 'Billing'|trans }}
                </a>
                <a href="{{ '/support'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-headset"></i>
                    {{ 'Support'|trans }}
                </a>
                <a href="{{ '/order'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-cart-shopping"></i>
                    {{ 'Order'|trans }}
                </a>
                {% if guest.extension_is_on({"mod":"news"}) %}
                <a href="{{ '/news'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-newspaper"></i>
                    {{ 'News'|trans }}
                </a>
                {% endif %}
                {% if guest.support_kb_enabled() %}
                <a href="{{ '/support/kb'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-book"></i>
                    {{ 'Knowledge Base'|trans }}
                </a>
                {% endif %}

                {% if client %}
                <div class="mobile-nav-divider"></div>
                <a href="{{ 'client/profile'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-user"></i>
                    {{ 'Profile'|trans }}
                </a>
                <a href="{{ 'client/balance'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-wallet"></i>
                    {{ 'Wallet'|trans }}
                </a>
                <a href="{{ '/email'|link }}" class="mobile-nav-link">
                    <i class="fa-solid fa-envelope"></i>
                    {{ 'Emails'|trans }}
                </a>
                <div class="mobile-nav-divider"></div>
                <a href="{{ 'client/logout'|link }}" class="mobile-nav-link text-danger">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    {{ 'Sign Out'|trans }}
                </a>
                {% else %}
                <div class="mobile-nav-divider"></div>
                <div class="d-grid gap-2 p-3">
                    <a href="{{ '/login'|link }}" class="btn btn-outline-primary">{{ 'Login'|trans }}</a>
                    <a href="{{ '/signup'|link }}" class="btn btn-primary">{{ 'Register'|trans }}</a>
                </div>
                {% endif %}

                <!-- Language Selector for Mobile -->
                {% if languages|length > 1 %}
                <div class="mobile-nav-divider"></div>
                <div class="p-3">
                    <label class="form-label text-muted small">{{ 'Language'|trans }}</label>
                    <select class="form-select form-select-sm lang-selector">
                        {% for lang in languages %}
                        <option value="{{ lang.locale }}">{{ lang.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
            </nav>
        </div>
    </div>

    <!-- Main Content -->
    <main class="app-main">
        <div class="container-xl py-4">
            <!-- Breadcrumb -->
            {% if settings.show_breadcrumb %}
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ '/'|link }}">{{ 'Home'|trans }}</a></li>
                    {% block breadcrumb %}{% endblock %}
                </ol>
            </nav>
            {% endif %}

            <!-- Flash Messages -->
            {{ include('partial_message.html.twig') }}

            <!-- Page Content -->
            {% block content_before %}{% endblock %}
            {% block content %}{% endblock %}
            {% block content_after %}{% endblock %}
        </div>
    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container-xl">
            <div class="footer-content">
                <div class="footer-brand">
                    &copy; {{ now|format_date(pattern='yyyy') }} {{ company.name }}
                </div>
                <div class="footer-links">
                    {% if settings.footer_link_1_enabled %}
                    <a href="{{ settings.footer_link_1_page|link }}">{{ settings.footer_link_1_title }}</a>
                    {% endif %}
                    {% if settings.footer_link_2_enabled %}
                    <a href="{{ settings.footer_link_2_page|link }}">{{ settings.footer_link_2_title }}</a>
                    {% endif %}
                    {% if settings.footer_link_3_enabled %}
                    <a href="{{ settings.footer_link_3_page|link }}">{{ settings.footer_link_3_title }}</a>
                    {% endif %}
                </div>
                {% if guest.extension_is_on({"mod":'branding'}) %}
                <div class="footer-powered">
                    {{ 'Powered by'|trans }} <a href="https://fossbilling.org" target="_blank">FOSSBilling</a>
                </div>
                {% endif %}
            </div>
        </div>
    </footer>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

{% endblock %}

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Theme JS -->
<script src="{{ 'js/flavor.js' | asset_url }}"></script>

{% if settings.inject_javascript %}
    {{ settings.inject_javascript | raw }}
{% endif %}

{{ include('partial_pending_messages.html.twig', ignore_missing: true) }}
{% if guest.extension_is_on({ "mod": "cookieconsent" }) %}
    {{ include('mod_cookieconsent_index.html.twig', ignore_missing: true) }}
{% endif %}

{{ DebugBar_render() }}
</body>
</html>
