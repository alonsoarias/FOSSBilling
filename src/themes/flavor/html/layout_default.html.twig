<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ settings.theme|default('light') }}">
<head>
    <meta charset="utf-8">
    <title>{{ settings.meta_title_prefix }} {% block meta_title %}{% endblock %} {{ settings.meta_title_suffix }}</title>

    <meta property="bb:url" content="{{ constant('SYSTEM_URL') }}">
    <meta property="bb:client_area" content="{{ '/'|link }}">
    <meta name="csrf-token" content="{{ CSRFToken }}">

    <meta name="description" content="{% block meta_description %}{{ settings.meta_description }}{% endblock %}">
    <meta name="keywords" content="{{ settings.meta_keywords }}">
    <meta name="robots" content="{{ settings.meta_robots }}">
    <meta name="author" content="{{ settings.meta_author }}">
    <meta name="generator" content="FOSSBilling">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% block opengraph %}{% endblock %}

    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">

    <!-- Google Fonts - IngeWeb Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Font Awesome 3 (Legacy compatibility) -->
    <link rel="stylesheet" type="text/css" href="{{ 'css/font-awesome.css' | asset_url }}">

    <!-- Flag Icons -->
    <link href="https://cdn.jsdelivr.net/npm/flag-icons@7.1.0/css/flag-icons.min.css" rel="stylesheet">

    <!-- Theme CSS -->
    <link rel="stylesheet" href="{{ 'css/flavor.css' | asset_url }}">

    <!-- jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>

    <!-- API -->
    {{ "Api/API.js" | library_url | script_tag }}

    {{ DebugBar_renderHead() }}

    {% block head %}{% endblock %}
    {% block js %}{% endblock %}
</head>

<body class="{% block body_class %}{% endblock %}">

{% block body %}

{% if not client and settings.require_login %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const publicPaths = ['/news', '/tos', '/privacy-policy', '/login', '/signup', '/password-reset', '/order'];
        const currentPath = window.location.pathname;
        const isAllowed = publicPaths.some(path => currentPath.startsWith(path));
        if (!isAllowed) {
            window.location.href = '{{ "login"|link }}';
        }
    });
</script>
{% endif %}

{% if client %}
    {% set profile = client.profile_get %}
{% endif %}
{% set company = guest.system_company %}

{% if settings.theme == 'dark' %}
    {% set logo_url = company.logo_url_dark %}
{% else %}
    {% set logo_url = company.logo_url %}
{% endif %}

<!-- Accent Top Bar -->
<div class="accent-bar"></div>

<!-- Main Container -->
<div class="main-wrapper">
    <!-- Header -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand" href="{{ '/'|link }}">
                    {% if logo_url and settings.show_company_logo %}
                        <img src="{{ logo_url }}" alt="{{ company.name }}" class="logo-img">
                    {% else %}
                        <span class="brand-text">{{ company.name }}</span>
                    {% endif %}
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <!-- Language Selector -->
                        {% set languages = guest.extension_languages(true) %}
                        {% if languages|length > 1 %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-globe"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                {% for lang in languages %}
                                <li>
                                    <a class="dropdown-item lang-item" href="#" data-lang="{{ lang.locale }}">
                                        <span class="fi fi-{{ lang.locale|split('_')[1]|lower }} me-2"></span>
                                        {{ lang.title }}
                                    </a>
                                </li>
                                {% endfor %}
                            </ul>
                        </li>
                        {% endif %}

                        {% if settings.top_menu_dashboard %}
                        <li class="nav-item d-none d-lg-block">
                            <a class="nav-link" href="{{ ''|link }}">{{ 'Dashboard'|trans }}</a>
                        </li>
                        {% endif %}

                        {% if settings.top_menu_order %}
                        <li class="nav-item d-none d-lg-block">
                            <a class="nav-link" href="{{ '/order'|link }}">{{ 'Order'|trans }}</a>
                        </li>
                        {% endif %}

                        {% if client %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-dropdown" href="#" data-bs-toggle="dropdown">
                                <img src="{{ profile.email|gravatar(32) }}" class="user-avatar" alt="">
                                <span class="d-none d-md-inline">{{ profile.first_name }}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header">
                                    <strong>{{ profile.first_name }} {{ profile.last_name }}</strong>
                                    {% if profile.company %}<br><small class="text-muted">{{ profile.company }}</small>{% endif %}
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ 'client/profile'|link }}"><i class="fa-solid fa-user me-2"></i>{{ 'Profile'|trans }}</a></li>
                                <li><a class="dropdown-item" href="{{ 'client/balance'|link }}"><i class="fa-solid fa-wallet me-2"></i>{{ 'Wallet'|trans }}</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ 'client/logout'|link }}"><i class="fa-solid fa-sign-out-alt me-2"></i>{{ 'Sign out'|trans }}</a></li>
                            </ul>
                        </li>
                        {% else %}
                        {% if settings.top_menu_profile %}
                        <li class="nav-item d-none d-lg-block">
                            <a class="btn btn-outline-primary btn-sm" href="{{ 'login'|link }}">{{ 'Login'|trans }}</a>
                        </li>
                        {% endif %}
                        {% if settings.top_menu_signout %}
                        <li class="nav-item d-none d-lg-block ms-2">
                            <a class="btn btn-primary btn-sm" href="{{ 'signup'|link }}">{{ 'Register'|trans }}</a>
                        </li>
                        {% endif %}
                        {% endif %}

                        <!-- Mobile Menu Items -->
                        <li class="nav-item d-lg-none w-100 mt-3">
                            <div class="mobile-menu">
                                {{ include('mobile_menu.html.twig') }}
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Content Area -->
    <main class="site-content">
        <div class="container py-4">
            <div class="row">
                <!-- Sidebar -->
                {% if client or not settings.hide_menu %}
                <div class="col-lg-3 d-none d-lg-block">
                    <aside class="sidebar">
                        <!-- User Card -->
                        {% if client and settings.sidebar_balance_enabled %}
                        <div class="user-card mb-4">
                            <div class="user-card-header">
                                <img src="{{ profile.email|gravatar(64) }}" class="user-card-avatar" alt="">
                                <div class="user-card-info">
                                    <div class="user-card-name">{{ profile.first_name }} {{ profile.last_name }}</div>
                                    <div class="user-card-email">{{ profile.email }}</div>
                                </div>
                            </div>
                            <div class="user-card-balance">
                                <span class="balance-label">{{ 'Balance'|trans }}</span>
                                <span class="balance-amount">{{ profile.balance | money(profile.currency) }}</span>
                            </div>
                        </div>
                        {% endif %}

                        <!-- Navigation -->
                        <nav class="sidebar-nav">
                            {{ include('partial_menu.html.twig') }}
                        </nav>

                        <!-- Sidebar Note -->
                        {% if settings.sidebar_note_enabled %}
                        <div class="sidebar-note mt-4">
                            <div class="note-icon"><i class="fa-solid fa-lightbulb"></i></div>
                            <div class="note-content">
                                <strong>{{ settings.sidebar_note_title }}</strong>
                                <p class="mb-0 mt-1">{{ settings.sidebar_note_content }}</p>
                            </div>
                        </div>
                        {% endif %}
                    </aside>
                </div>
                {% endif %}

                <!-- Main Content -->
                <div class="{% if client or not settings.hide_menu %}col-lg-9{% else %}col-12{% endif %}">
                    <!-- Breadcrumbs -->
                    {% if settings.show_breadcrumb %}
                    {% block breadcrumbs %}
                    <nav aria-label="{{ 'breadcrumb'|trans }}" class="mb-4">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ '/'|link }}">{{ 'Home'|trans }}</a></li>
                            {% block breadcrumb %}
                            <li class="breadcrumb-item active">{{ 'Dashboard'|trans }}</li>
                            {% endblock %}
                        </ol>
                    </nav>
                    {% endblock %}
                    {% endif %}

                    <!-- Content -->
                    <div class="content-area">
                        {% block content_before %}{% endblock %}
                        {% block content %}{% endblock %}
                        {{ include('partial_message.html.twig') }}
                        {% block content_after %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    {% if settings.footer_enabled %}
    <footer class="site-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <span class="copyright">&copy; {{ now|format_date(pattern='yyyy') }} {{ settings.footer_signature | default(company.signature) }}</span>
                    {% if company.bank_info_pagebottom == 1 %}
                    <div class="bank-info small mt-1">
                        <strong>{{ 'Payment Information'|trans }}</strong>: {{ company.bank_name }} | {{ company.bic }} | {{ company.account_number }}
                    </div>
                    {% endif %}
                </div>
                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                    <div class="footer-links">
                        {% if settings.footer_link_1_enabled %}
                        <a href="{% if 'http' in settings.footer_link_1_page %}{{ settings.footer_link_1_page }}{% else %}{{ settings.footer_link_1_page|link }}{% endif %}">{{ settings.footer_link_1_title }}</a>
                        {% endif %}
                        {% if settings.footer_link_2_enabled %}
                        <a href="{% if 'http' in settings.footer_link_2_page %}{{ settings.footer_link_2_page }}{% else %}{{ settings.footer_link_2_page|link }}{% endif %}">{{ settings.footer_link_2_title }}</a>
                        {% endif %}
                        {% if settings.footer_link_3_enabled %}
                        <a href="{% if 'http' in settings.footer_link_3_page %}{{ settings.footer_link_3_page }}{% else %}{{ settings.footer_link_3_page|link }}{% endif %}">{{ settings.footer_link_3_title }}</a>
                        {% endif %}
                        {% if settings.footer_link_4_enabled %}
                        <a href="{% if 'http' in settings.footer_link_4_page %}{{ settings.footer_link_4_page }}{% else %}{{ settings.footer_link_4_page|link }}{% endif %}">{{ settings.footer_link_4_title }}</a>
                        {% endif %}
                    </div>
                    {% if guest.extension_is_on({"mod":'branding'}) %}
                    <div class="powered-by small mt-2">
                        {{ 'Powered by'|trans }} <a href="https://fossbilling.org" target="_blank">FOSSBilling</a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </footer>
    {% endif %}
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1070;"></div>

<!-- Back to Top -->
{% if settings.footer_to_top_enabled %}
<a href="#" class="back-to-top" id="backToTop">
    <i class="fa-solid fa-chevron-up"></i>
</a>
{% endif %}

<!-- Loading Overlay -->
<div class="loading-overlay wait" style="display:none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">{{ 'Loading...'|trans }}</span>
    </div>
</div>

<noscript>{{ "NOTE: Many features on FOSSBilling require Javascript and cookies. You can enable both in your browser's preference settings."|trans }}</noscript>

{% endblock %}

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Theme JS -->
<script src="{{ 'js/flavor.js' | asset_url }}"></script>

{% if settings.inject_javascript %}
{{ settings.inject_javascript | raw }}
{% endif %}

{{ include('partial_pending_messages.html.twig', ignore_missing: true) }}
{% if guest.extension_is_on({ "mod": "cookieconsent" }) %}
{{ include('mod_cookieconsent_index.html.twig', ignore_missing: true) }}
{% endif %}

{{ DebugBar_render() }}
</body>
</html>
