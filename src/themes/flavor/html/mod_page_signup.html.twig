{% extends "layout_public.html.twig" %}

{% set company = guest.system_company %}
{% if settings.theme == 'dark' %}
    {% set logo_url = company.logo_url_dark %}
{% else %}
    {% set logo_url = company.logo_url %}
{% endif %}

{% block meta_title %}{{ 'Sign Up'|trans }}{% endblock %}
{% block body_class %}page-signup{% endblock %}

{% import "macro_functions.html.twig" as mf %}

{% block body %}
<div class="auth-container" style="max-width: 520px;">
    {% if settings.login_page_show_logo %}
    <div class="auth-logo">
        <a href="{{ settings.login_page_logo_url|default('/') }}">
            <img src="{{ logo_url }}" alt="{{ company.name }}">
        </a>
    </div>
    {% endif %}

    <div class="auth-card">
        <h1 class="auth-title">{{ 'Create Account'|trans }}</h1>
        <p class="auth-subtitle">{{ 'Fill in the form below to get started'|trans }}</p>

        <form class="api-form" action="{{ 'api/guest/client/create'|link }}" method="post" data-api-redirect="{{ '/'|link }}">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="first_name">{{ 'First Name'|trans }}</label>
                    <input class="form-control" id="first_name" type="text" name="first_name" value="{{ request.first_name }}" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="last_name">{{ 'Last Name'|trans }}</label>
                    <input class="form-control" id="last_name" type="text" name="last_name" value="{{ request.last_name }}" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="email">{{ 'Email'|trans }}</label>
                <input class="form-control" id="email" type="email" name="email" value="{{ request.email }}" required>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="password">{{ 'Password'|trans }}</label>
                    <input class="form-control" id="password" type="password" name="password" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="password_confirm">{{ 'Confirm Password'|trans }}</label>
                    <input class="form-control" id="password_confirm" type="password" name="password_confirm" required>
                </div>
            </div>

            {% set custom_fields = guest.client_custom_fields %}
            {% if custom_fields %}
                {% for field in custom_fields %}
                <div class="mb-3">
                    <label class="form-label" for="custom_{{ field.id }}">{{ field.title|trans }}</label>
                    {% if field.type == 'select' %}
                        <select class="form-select" id="custom_{{ field.id }}" name="custom_{{ field.id }}" {% if field.required %}required{% endif %}>
                            <option value="">-- {{ 'Select'|trans }} --</option>
                            {% for option in field.options %}
                                <option value="{{ option }}">{{ option }}</option>
                            {% endfor %}
                        </select>
                    {% elseif field.type == 'textarea' %}
                        <textarea class="form-control" id="custom_{{ field.id }}" name="custom_{{ field.id }}" {% if field.required %}required{% endif %}></textarea>
                    {% else %}
                        <input class="form-control" type="text" id="custom_{{ field.id }}" name="custom_{{ field.id }}" {% if field.required %}required{% endif %}>
                    {% endif %}
                </div>
                {% endfor %}
            {% endif %}

            {{ mf.recaptcha() }}

            {% if settings.signup_tos == 'explicit' %}
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="tos" name="tos" required>
                <label class="form-check-label" for="tos">
                    {{ 'I agree to the'|trans }}
                    <a href="{{ '/tos'|link }}" target="_blank">{{ 'Terms of Service'|trans }}</a>
                    {{ 'and'|trans }}
                    <a href="{{ '/privacy-policy'|link }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>
                </label>
            </div>
            {% elseif settings.signup_tos == 'implicit' %}
            <p class="text-muted small mb-3">
                {{ 'By creating an account, you agree to our'|trans }}
                <a href="{{ '/tos'|link }}" target="_blank">{{ 'Terms of Service'|trans }}</a>
                {{ 'and'|trans }}
                <a href="{{ '/privacy-policy'|link }}" target="_blank">{{ 'Privacy Policy'|trans }}</a>.
            </p>
            {% endif %}

            <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
                <i class="fa-solid fa-user-plus me-2"></i>{{ 'Create Account'|trans }}
            </button>
        </form>

        <div class="auth-footer">
            {{ 'Already have an account?'|trans }}
            <a href="{{ 'login'|link }}">{{ 'Sign in'|trans }}</a>
        </div>
    </div>
</div>
{% endblock %}
