{% macro selectbox(name, options, selected, required, nullOption) %}
    <select name="{{ name }}" class="form-select{% if required %} is-required{% endif %}">
        {% if nullOption %}<option value="">{{ nullOption }}</option>{% endif %}
        {% for val, label in options %}
        <option value="{{ val }}" {% if selected == val %}selected{% endif %}>{{ label }}</option>
        {% endfor %}
    </select>
{% endmacro %}

{% macro selectboxtld(name, options, selected, required) %}
    <select name="{{ name }}" class="form-select{% if required %} is-required{% endif %}" style="width: 100px;">
        {% for data in options %}
        <option value="{{ data.tld }}" {% if selected == data.tld %}selected{% endif %}>{{ data.tld }}</option>
        {% endfor %}
    </select>
{% endmacro %}

{% macro status_name(status) %}
    {% set status = status|replace({'_': " "})|title|trim %}
    {% if status == 'Active' %}
        {{ 'Active'|trans }}
    {% elseif status == 'Pending Setup' %}
        {{ 'Pending Setup'|trans }}
    {% elseif status == 'Failed Setup' %}
        {{ 'Failed Setup'|trans }}
    {% elseif status == 'Failed Renew' %}
        {{ 'Failed Renewal'|trans }}
    {% elseif status == 'Suspended' %}
        {{ 'Suspended'|trans }}
    {% elseif status == 'Canceled' %}
        {{ 'Canceled'|trans }}
    {% elseif status == 'Paid' %}
        {{ 'Paid'|trans }}
    {% elseif status == 'Unpaid' %}
        {{ 'Unpaid'|trans }}
    {% elseif status == 'Refunded' %}
        {{ 'Refunded'|trans }}
    {% elseif status == 'Open' %}
        {{ 'Open'|trans }}
    {% elseif status == 'On Hold' %}
        {{ 'On Hold'|trans }}
    {% elseif status == 'Closed' %}
        {{ 'Closed'|trans }}
    {% else %}
        {{ status|trans }}
    {% endif %}
{% endmacro %}

{% macro status_badge(status) %}
    {% set status_lower = status|lower|replace({' ': '_'}) %}
    {% if status_lower == 'active' or status_lower == 'paid' or status_lower == 'open' %}
        <span class="badge badge-success">{{ _self.status_name(status) }}</span>
    {% elseif status_lower == 'pending_setup' or status_lower == 'unpaid' or status_lower == 'on_hold' %}
        <span class="badge badge-warning">{{ _self.status_name(status) }}</span>
    {% elseif status_lower == 'failed_setup' or status_lower == 'suspended' or status_lower == 'failed_renew' %}
        <span class="badge badge-danger">{{ _self.status_name(status) }}</span>
    {% elseif status_lower == 'canceled' or status_lower == 'closed' or status_lower == 'refunded' %}
        <span class="badge badge-secondary">{{ _self.status_name(status) }}</span>
    {% else %}
        <span class="badge badge-info">{{ _self.status_name(status) }}</span>
    {% endif %}
{% endmacro %}

{% macro recaptcha() %}
{% if guest.extension_is_on({"mod":"spamchecker"}) %}
{% set rc = guest.spamchecker_recaptcha %}
    {% if rc.enabled %}
        {% if rc.version == 2 %}
            <script src='https://www.google.com/recaptcha/api.js' async defer></script>
            <div class="g-recaptcha" data-sitekey="{{ rc.publickey }}"></div>
        {% endif %}
    {% endif %}
{% endif %}
{% endmacro %}

{% macro wysiwyg(selector) %}
{% if guest.extension_is_on({"mod":"wysiwyg"}) %}
{{ include('mod_wysiwyg_js.html.twig', { 'class': selector|trim('.#') }) }}
{% else %}
<!-- WYSIWYG not enabled -->
{% endif %}
{% endmacro %}

{% macro empty_state(icon, title, description, action_url, action_text) %}
<div class="empty-state">
    <div class="empty-state-icon">
        <i class="fa-solid fa-{{ icon }}"></i>
    </div>
    <h5 class="empty-state-title">{{ title }}</h5>
    <p class="empty-state-text">{{ description }}</p>
    {% if action_url and action_text %}
    <a href="{{ action_url }}" class="btn btn-primary">
        <i class="fa-solid fa-plus me-2"></i>{{ action_text }}
    </a>
    {% endif %}
</div>
{% endmacro %}
