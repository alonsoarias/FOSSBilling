{% extends "layout_default.html.twig" %}

{% block meta_title %}{{ 'Error'|trans }} {{ exception.getCode }}{% endblock %}

{% block body_class %}error-page{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Error'|trans }}</li>
{% endblock %}

{% block content %}
<div class="error-container">
    <div class="error-content">
        <div class="error-code">
            {% if exception.getCode %}
                {{ exception.getCode }}
            {% else %}
                404
            {% endif %}
        </div>
        <h1 class="error-title">{{ 'Oops! Something went wrong'|trans }}</h1>
        <p class="error-message">{{ exception.getMessage|default("The page you are looking for could not be found."|trans) }}</p>
        <div class="error-actions">
            <a href="{{ '/' | link }}" class="btn btn-primary">
                <i class="fa-solid fa-house me-2"></i>{{ 'Go to Dashboard'|trans }}
            </a>
            <a href="{{ '/support'|link({ 'ticket': 1 }) }}" class="btn btn-outline-primary">
                <i class="fa-solid fa-headset me-2"></i>{{ 'Contact Support'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
