{% block content %}
<fieldset>
    <legend>{{ 'Appearance'|trans }}</legend>

    <h3>{{ 'Theme Mode'|trans }}</h3>
    <select name="theme">
        <option value="light" selected>{{ 'Light Mode'|trans }}</option>
        <option value="dark">{{ 'Dark Mode'|trans }}</option>
    </select>

    <h3>{{ 'Branding'|trans }}</h3>
    <table>
        <tr>
            <td><label>{{ 'Show company logo'|trans }}</label></td>
            <td>
                <label><input type="radio" name="show_company_logo" value="1" checked="checked">{{ 'Yes'|trans }}</label>
                <label><input type="radio" name="show_company_logo" value="0">{{ 'No'|trans }}</label>
            </td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>{{ 'Navigation'|trans }}</legend>

    <h3>{{ 'Breadcrumbs'|trans }}</h3>
    <table>
        <tr>
            <td><label>{{ 'Show breadcrumbs'|trans }}</label></td>
            <td>
                <label><input type="radio" name="show_breadcrumb" value="1" checked="checked">{{ 'Yes'|trans }}</label>
                <label><input type="radio" name="show_breadcrumb" value="0">{{ 'No'|trans }}</label>
            </td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>{{ 'Access Control'|trans }}</legend>

    <table>
        <tr>
            <td><label>{{ 'Require login to access dashboard'|trans }}</label></td>
            <td>
                <label><input type="radio" name="require_login" value="1">{{ 'Yes'|trans }}</label>
                <label><input type="radio" name="require_login" value="0" checked="checked">{{ 'No'|trans }}</label>
            </td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>{{ 'Login Page'|trans }}</legend>

    <table>
        <tr>
            <td><label>{{ 'Show logo on login page'|trans }}</label></td>
            <td>
                <label><input type="radio" name="login_page_show_logo" value="1" checked="checked">{{ 'Yes'|trans }}</label>
                <label><input type="radio" name="login_page_show_logo" value="0">{{ 'No'|trans }}</label>
            </td>
        </tr>
        <tr>
            <td><label>{{ 'Custom logo URL (optional)'|trans }}</label></td>
            <td><input type="text" name="login_page_logo_url" value="" placeholder="https://"></td>
        </tr>
        <tr>
            <td><label>{{ 'Show password reset link'|trans }}</label></td>
            <td>
                <label><input type="radio" name="show_password_reset_link" value="1" checked="checked">{{ 'Yes'|trans }}</label>
                <label><input type="radio" name="show_password_reset_link" value="0">{{ 'No'|trans }}</label>
            </td>
        </tr>
        <tr>
            <td><label>{{ 'Show signup link'|trans }}</label></td>
            <td>
                <label><input type="radio" name="show_signup_link" value="1" checked="checked">{{ 'Yes'|trans }}</label>
                <label><input type="radio" name="show_signup_link" value="0">{{ 'No'|trans }}</label>
            </td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>{{ 'Meta Information'|trans }}</legend>

    <table>
        <tr>
            <td><label for="meta_description">{{ 'Meta description'|trans }}</label></td>
            <td><input type="text" name="meta_description" id="meta_description" value=""></td>
        </tr>
        <tr>
            <td><label for="meta_keywords">{{ 'Meta keywords'|trans }}</label></td>
            <td><input type="text" name="meta_keywords" id="meta_keywords" value=""></td>
        </tr>
        <tr>
            <td><label for="meta_robots">{{ 'Meta robots'|trans }}</label></td>
            <td><input type="text" name="meta_robots" id="meta_robots" value="index, follow"></td>
        </tr>
        <tr>
            <td><label for="meta_author">{{ 'Meta author'|trans }}</label></td>
            <td><input type="text" name="meta_author" id="meta_author" value=""></td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>{{ 'Footer'|trans }}</legend>

    <table>
        <tr>
            <td><label>{{ 'Footer link #1'|trans }}</label></td>
            <td>
                <label><input type="checkbox" name="footer_link_1_enabled"></label>
                <input type="text" name="footer_link_1_title" placeholder="{{ 'Link Title'|trans }}" value="">
                <span> -> </span>
                <input type="text" name="footer_link_1_page" placeholder="{{ 'URL or Page Path'|trans }}">
            </td>
        </tr>
        <tr>
            <td><label>{{ 'Footer link #2'|trans }}</label></td>
            <td>
                <label><input type="checkbox" name="footer_link_2_enabled"></label>
                <input type="text" name="footer_link_2_title" placeholder="{{ 'Link Title'|trans }}" value="">
                <span> -> </span>
                <input type="text" name="footer_link_2_page" placeholder="{{ 'URL or Page Path'|trans }}">
            </td>
        </tr>
        <tr>
            <td><label>{{ 'Footer link #3'|trans }}</label></td>
            <td>
                <label><input type="checkbox" name="footer_link_3_enabled"></label>
                <input type="text" name="footer_link_3_title" placeholder="{{ 'Link Title'|trans }}" value="">
                <span> -> </span>
                <input type="text" name="footer_link_3_page" placeholder="{{ 'URL or Page Path'|trans }}">
            </td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>{{ 'Advanced'|trans }}</legend>

    <h3>{{ 'Custom JavaScript'|trans }}</h3>
    <table>
        <tr>
            <td><label for="inject_javascript">{{ 'Inject custom JavaScript (footer)'|trans }}</label></td>
            <td><textarea name="inject_javascript" id="inject_javascript" rows="5" placeholder="<script>...</script>"></textarea></td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>{{ 'Checkout & Signup'|trans }}</legend>

    <table>
        <tr>
            <td><label>{{ 'Terms of service requirement (checkout)'|trans }}</label></td>
            <td>
                <select name="checkout_tos">
                    <option value="explicit">{{ 'Explicit agreement (checkbox)'|trans }}</option>
                    <option value="implicit">{{ 'Implicit agreement (link only)'|trans }}</option>
                    <option value="none">{{ 'None'|trans }}</option>
                </select>
            </td>
        </tr>
        <tr>
            <td><label>{{ 'Terms of service requirement (signup)'|trans }}</label></td>
            <td>
                <select name="signup_tos">
                    <option value="explicit">{{ 'Explicit agreement (checkbox)'|trans }}</option>
                    <option value="implicit">{{ 'Implicit agreement (link only)'|trans }}</option>
                    <option value="none">{{ 'None'|trans }}</option>
                </select>
            </td>
        </tr>
    </table>
</fieldset>
{% endblock %}
