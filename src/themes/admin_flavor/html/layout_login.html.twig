{% set company = guest.system_company %}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <title>{% block meta_title %}{{ 'Login'|trans }}{% endblock %} - {{ company.name }}</title>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ CSRFToken }}">

    <link rel="shortcut icon" href="{{ company.favicon_url }}">

    {{ include('partial_bb_meta.html.twig') }}

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel='stylesheet' type='text/css' href="{{ 'css/font-awesome.css' | asset_url }}">
    <!-- Flavor Admin Theme -->
    <link rel='stylesheet' type='text/css' href="{{ 'css/flavor-admin.css' | asset_url }}">

    {{ "Api/API.js" | library_url | script_tag }}

    <!-- jQuery and Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    {{ DebugBar_renderHead() }}

    <style>
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #673de6 0%, #1a1a2e 100%);
            padding: 2rem;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 1rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .login-header {
            background: #1a1a2e;
            padding: 2rem;
            text-align: center;
        }

        .login-header img {
            max-height: 48px;
            width: auto;
        }

        .login-body {
            padding: 2rem;
        }

        .login-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 0.5rem;
        }

        .login-subtitle {
            color: #6c757d;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
        }

        .form-floating > label {
            color: #6c757d;
        }

        .form-floating > .form-control:focus ~ label {
            color: #673de6;
        }

        .btn-login {
            background: #673de6;
            border: none;
            padding: 0.75rem;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 0.5rem;
            transition: all 0.2s ease;
        }

        .btn-login:hover {
            background: #5025d1;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(103, 61, 230, 0.4);
        }

        .login-footer {
            text-align: center;
            padding: 1.5rem 2rem;
            background: #f8f9fa;
            border-top: 1px solid #e9ecef;
        }

        .login-footer a {
            color: #673de6;
            text-decoration: none;
            font-weight: 500;
        }

        .login-footer a:hover {
            text-decoration: underline;
        }
    </style>

    {% block head %}{% endblock %}
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-header">
                {% if company.logo_url_dark %}
                    <img src="{{ company.logo_url_dark }}" alt="{{ company.name }}">
                {% else %}
                    <h2 class="text-white mb-0">{{ company.name }}</h2>
                {% endif %}
            </div>
            <div class="login-body">
                {% block content %}{% endblock %}
            </div>
            <div class="login-footer">
                <small class="text-muted">
                    {{ 'Powered by'|trans }} <a href="https://fossbilling.org" target="_blank">FOSSBilling</a>
                </small>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1070;"></div>

    <script>
    globalThis.bb = {
        restUrl: function(url) {
            if (url.indexOf('http://') > -1 || url.indexOf('https://') > -1) return url;
            return $('meta[property="bb:url"]').attr('content') + 'index.php?_url=/api/' + url;
        },
        redirect: function(url) { window.location = url; },
        reload: function() { window.location.reload(true); },
        _afterComplete: function(obj, result) {
            if (obj.hasAttribute('data-api-redirect')) {
                window.location = obj.getAttribute('data-api-redirect');
                return;
            }
            if (result) {
                FOSSBilling.message('Success', 'success');
            }
        },
        apiForm: function() {
            var formElements = document.getElementsByClassName('api-form');
            for (var i = 0; i < formElements.length; i++) {
                formElements[i].addEventListener('submit', function(event) {
                    event.preventDefault();
                    var formElement = this;
                    var formData = new FormData(formElement);
                    var data = {};
                    formData.forEach(function(value, key) { data[key] = value; });
                    API.makeRequest(
                        formElement.getAttribute('method'),
                        bb.restUrl(formElement.getAttribute('action')),
                        JSON.stringify(data),
                        function(result) { return bb._afterComplete(formElement, result); },
                        function(error) { FOSSBilling.message(error.message, 'error'); }
                    );
                });
            }
        }
    };

    globalThis.FOSSBilling = {
        message: function(message, type) {
            type = type || 'info';
            var color = type === 'error' ? 'danger' : (type === 'warning' ? 'warning' : 'primary');
            var container = document.querySelector('.toast-container');
            var element = document.createElement('div');
            container.appendChild(element);
            element.classList.add('toast', 'show');
            element.innerHTML = '<div class="toast-header"><span class="p-2 bg-' + color + ' rounded-circle me-2"></span><strong class="me-auto">System</strong><button type="button" class="btn-close" data-bs-dismiss="toast"></button></div><div class="toast-body">' + message + '</div>';
            var toast = new bootstrap.Toast(element);
            toast.show();
        }
    };

    $(function() {
        if ($('form.api-form').length) bb.apiForm();
    });
    </script>

    {{ DebugBar_render() }}

    {% block js %}{% endblock %}
</body>
</html>
