{% if pager.pages > 1 %}
<nav aria-label="{{ 'Page navigation'|trans }}">
    <ul class="pagination justify-content-center mb-0">
        {% if pager.current > 1 %}
            <li class="page-item">
                <a class="page-link" href="{{ request._url }}?page={{ pager.current - 1 }}&CSRFToken={{ CSRFToken }}{% for key, value in request %}{% if key != 'page' and key != '_url' and key != 'CSRFToken' %}&{{ key }}={{ value }}{% endif %}{% endfor %}" aria-label="{{ 'Previous'|trans }}">
                    <i class="fa fa-chevron-left"></i>
                </a>
            </li>
        {% else %}
            <li class="page-item disabled">
                <span class="page-link"><i class="fa fa-chevron-left"></i></span>
            </li>
        {% endif %}

        {% for page in 1..pager.pages %}
            {% if page == pager.current %}
                <li class="page-item active"><span class="page-link">{{ page }}</span></li>
            {% elseif page >= pager.current - 2 and page <= pager.current + 2 %}
                <li class="page-item">
                    <a class="page-link" href="{{ request._url }}?page={{ page }}&CSRFToken={{ CSRFToken }}{% for key, value in request %}{% if key != 'page' and key != '_url' and key != 'CSRFToken' %}&{{ key }}={{ value }}{% endif %}{% endfor %}">{{ page }}</a>
                </li>
            {% elseif page == 1 or page == pager.pages %}
                <li class="page-item">
                    <a class="page-link" href="{{ request._url }}?page={{ page }}&CSRFToken={{ CSRFToken }}{% for key, value in request %}{% if key != 'page' and key != '_url' and key != 'CSRFToken' %}&{{ key }}={{ value }}{% endif %}{% endfor %}">{{ page }}</a>
                </li>
            {% elseif page == 2 or page == pager.pages - 1 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}
        {% endfor %}

        {% if pager.current < pager.pages %}
            <li class="page-item">
                <a class="page-link" href="{{ request._url }}?page={{ pager.current + 1 }}&CSRFToken={{ CSRFToken }}{% for key, value in request %}{% if key != 'page' and key != '_url' and key != 'CSRFToken' %}&{{ key }}={{ value }}{% endif %}{% endfor %}" aria-label="{{ 'Next'|trans }}">
                    <i class="fa fa-chevron-right"></i>
                </a>
            </li>
        {% else %}
            <li class="page-item disabled">
                <span class="page-link"><i class="fa fa-chevron-right"></i></span>
            </li>
        {% endif %}
    </ul>
</nav>
{% endif %}
