{% extends "layout_login.html.twig" %}

{% block meta_title %}{{ 'Error'|trans }}{% endblock %}

{% block content %}
<div class="text-center">
    <h1 class="login-title text-danger">{{ 'Error'|trans }}</h1>
    <p class="login-subtitle">{{ message }}</p>

    <a href="{{ '/'|alink }}" class="btn btn-primary btn-login w-100 mt-3">
        <i class="fa fa-home me-2"></i>{{ 'Go to Dashboard'|trans }}
    </a>
</div>
{% endblock %}
