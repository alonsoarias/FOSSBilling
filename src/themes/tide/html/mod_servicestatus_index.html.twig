{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Estado del Sistema'|trans }}{% endblock %}
{% block meta_description %}{{ 'Consulta el estado actual de nuestros servicios e infraestructura.'|trans }}{% endblock %}

{% block body_class %}status-page{% endblock %}

{% block content %}
    {% set overall = guest.servicestatus_get_overall_status %}
    {% set components = guest.servicestatus_component_get_grouped %}
    {% set active_incidents = guest.servicestatus_incident_get_active %}
    {% set maintenance = guest.servicestatus_maintenance_get_scheduled %}
    {% set recent = guest.servicestatus_incident_get_recent({'days': 7}) %}

    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">{{ 'System Status'|trans }}</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            {# Overall Status Banner #}
            <div class="card mb-4 border-{{ overall.color }} border-2">
                <div class="card-body text-center py-5">
                    <div class="mb-3">
                        {% if overall.status == 'operational' %}
                            <span class="avatar avatar-xl bg-{{ overall.color }}-lt">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-{{ overall.color }}" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                    <path d="M5 12l5 5l10 -10"></path>
                                </svg>
                            </span>
                        {% else %}
                            <span class="avatar avatar-xl bg-{{ overall.color }}-lt">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-{{ overall.color }}" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                    <path d="M12 9v2m0 4v.01"></path>
                                    <path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75"></path>
                                </svg>
                            </span>
                        {% endif %}
                    </div>
                    <h2 class="h1 text-{{ overall.color }} mb-1">{{ overall.label }}</h2>
                    <p class="text-muted mb-0">{{ 'Last updated'|trans }}: {{ "now"|date("d/m/Y H:i") }}</p>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    {# Active Incidents #}
                    {% if active_incidents|length > 0 %}
                    <div class="card mb-4 border-warning border-start border-3">
                        <div class="card-header bg-warning-lt">
                            <h3 class="card-title">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                    <path d="M12 9v2m0 4v.01"></path>
                                    <path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75"></path>
                                </svg>
                                {{ 'Active Incidents'|trans }}
                            </h3>
                        </div>
                        <div class="list-group list-group-flush">
                            {% for incident in active_incidents %}
                            <a href="{{ '/status/incident'|link }}/{{ incident.id }}" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="mb-1">{{ incident.title }}</h5>
                                        {% if incident.components|length > 0 %}
                                        <div class="mb-1">
                                            {% for comp in incident.components %}
                                                <span class="badge bg-secondary-lt">{{ comp.name }}</span>
                                            {% endfor %}
                                        </div>
                                        {% endif %}
                                        {% if incident.updates|length > 0 %}
                                        <p class="text-muted small mb-0">{{ incident.updates[0].message|truncate(150) }}</p>
                                        {% endif %}
                                    </div>
                                    <span class="badge bg-warning">{{ incident.status_label }}</span>
                                </div>
                            </a>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {# Scheduled Maintenance #}
                    {% if maintenance|length > 0 %}
                    <div class="card mb-4 border-info border-start border-3">
                        <div class="card-header bg-info-lt">
                            <h3 class="card-title">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                    <path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5"></path>
                                </svg>
                                {{ 'Scheduled Maintenance'|trans }}
                            </h3>
                        </div>
                        <div class="list-group list-group-flush">
                            {% for item in maintenance %}
                            <a href="{{ '/status/incident'|link }}/{{ item.id }}" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="mb-1">{{ item.title }}</h5>
                                        <p class="text-muted small mb-1">
                                            <strong>{{ 'Scheduled for'|trans }}:</strong>
                                            {{ item.scheduled_for|format_datetime }}
                                            {% if item.scheduled_until %} - {{ item.scheduled_until|format_datetime }}{% endif %}
                                        </p>
                                        {% if item.components|length > 0 %}
                                        <div>
                                            {% for comp in item.components %}
                                                <span class="badge bg-secondary-lt">{{ comp.name }}</span>
                                            {% endfor %}
                                        </div>
                                        {% endif %}
                                    </div>
                                    <span class="badge bg-info">{{ item.status_label }}</span>
                                </div>
                            </a>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {# Components Status #}
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3 class="card-title">{{ 'Current Status'|trans }}</h3>
                        </div>
                        <div class="card-body p-0">
                            {% for group_name, group_components in components %}
                            <div class="component-group">
                                {% if group_name %}
                                <div class="bg-light px-3 py-2 border-bottom">
                                    <strong>{{ group_name }}</strong>
                                </div>
                                {% endif %}
                                {% for component in group_components %}
                                <div class="d-flex justify-content-between align-items-center px-3 py-3 border-bottom">
                                    <div>
                                        <span class="fw-medium">{{ component.name }}</span>
                                        {% if component.description %}
                                            <small class="text-muted d-block">{{ component.description }}</small>
                                        {% endif %}
                                    </div>
                                    <span class="badge bg-{{ component.status_color }}">{{ component.status_label }}</span>
                                </div>
                                {% endfor %}
                            </div>
                            {% else %}
                            <div class="text-center py-4 text-muted">
                                {{ 'No components configured.'|trans }}
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    {# Recent Incidents Sidebar #}
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">{{ 'Past Incidents'|trans }}</h3>
                            <div class="card-actions">
                                <a href="{{ '/status/history'|link }}" class="btn btn-sm btn-outline-primary">
                                    {{ 'View All'|trans }}
                                </a>
                            </div>
                        </div>
                        <div class="list-group list-group-flush">
                            {% if recent|length > 0 %}
                                {% for incident in recent|slice(0, 5) %}
                                <a href="{{ '/status/incident'|link }}/{{ incident.id }}" class="list-group-item list-group-item-action">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-medium">{{ incident.title }}</div>
                                            <small class="text-muted">{{ incident.created_at|format_datetime }}</small>
                                        </div>
                                        <span class="badge bg-{{ incident.is_resolved ? 'success' : 'warning' }}">
                                            {{ incident.status_label }}
                                        </span>
                                    </div>
                                </a>
                                {% endfor %}
                            {% else %}
                                <div class="list-group-item text-center text-muted py-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-success mb-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <path d="M5 12l5 5l10 -10"></path>
                                    </svg>
                                    <div>{{ 'No incidents in the past 7 days'|trans }}</div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block head %}
<style>
.border-orange {
    border-color: #fd7e14 !important;
}
.bg-orange {
    background-color: #fd7e14 !important;
}
.bg-orange-lt {
    background-color: rgba(253, 126, 20, 0.1) !important;
}
.text-orange {
    color: #fd7e14 !important;
}
.component-group:last-child .border-bottom:last-child {
    border-bottom: none !important;
}
</style>
{% endblock %}
