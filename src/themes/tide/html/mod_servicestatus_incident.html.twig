{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ incident.title }} - {{ 'System Status'|trans }}{% endblock %}

{% block body_class %}status-incident{% endblock %}

{% block content %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <a href="{{ '/status'|link }}" class="btn btn-ghost-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M5 12l14 0"></path>
                            <path d="M5 12l6 6"></path>
                            <path d="M5 12l6 -6"></path>
                        </svg>
                        {{ 'Back to Status'|trans }}
                    </a>
                </div>
                <div class="col">
                    <h2 class="page-title">
                        {% if incident.is_scheduled %}
                            {{ 'Scheduled Maintenance'|trans }}
                        {% else %}
                            {{ 'Incident Report'|trans }}
                        {% endif %}
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    {# Incident Header #}
                    <div class="card mb-4">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-start w-100">
                                <h3 class="card-title mb-0">{{ incident.title }}</h3>
                                <span class="badge bg-{% if incident.is_resolved %}success{% elseif incident.status == 'monitoring' %}info{% else %}warning{% endif %} fs-6">
                                    {{ incident.status_label }}
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ 'Impact'|trans }}</div>
                                        <div class="datagrid-content">
                                            <span class="badge bg-{% if incident.impact == 'critical' %}danger{% elseif incident.impact == 'major' %}warning{% elseif incident.impact == 'minor' %}info{% else %}secondary{% endif %}">
                                                {{ incident.impact|capitalize }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ 'Started'|trans }}</div>
                                        <div class="datagrid-content">{{ incident.created_at|format_datetime }}</div>
                                    </div>
                                </div>
                                {% if incident.is_scheduled %}
                                <div class="col-sm-6">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ 'Scheduled For'|trans }}</div>
                                        <div class="datagrid-content">{{ incident.scheduled_for|format_datetime }}</div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ 'Expected End'|trans }}</div>
                                        <div class="datagrid-content">{{ incident.scheduled_until|format_datetime|default('-') }}</div>
                                    </div>
                                </div>
                                {% endif %}
                                {% if incident.resolved_at %}
                                <div class="col-sm-6">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ 'Resolved'|trans }}</div>
                                        <div class="datagrid-content">{{ incident.resolved_at|format_datetime }}</div>
                                    </div>
                                </div>
                                {% endif %}
                                {% if incident.components|length > 0 %}
                                <div class="col-12">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ 'Affected Components'|trans }}</div>
                                        <div class="datagrid-content">
                                            {% for comp in incident.components %}
                                                <span class="badge bg-{{ comp.status_color }} me-1">{{ comp.name }}</span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Updates Timeline #}
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">{{ 'Updates'|trans }}</h3>
                        </div>
                        <div class="card-body">
                            {% if incident.updates|length > 0 %}
                            <ul class="timeline">
                                {% for update in incident.updates %}
                                <li class="timeline-event">
                                    <div class="timeline-event-icon bg-{% if update.status == 'resolved' %}success{% elseif update.status == 'monitoring' %}info{% elseif update.status == 'identified' %}warning{% else %}secondary{% endif %}">
                                        {% if update.status == 'resolved' %}
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path d="M5 12l5 5l10 -10"></path>
                                            </svg>
                                        {% elseif update.status == 'monitoring' %}
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                                                <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path>
                                            </svg>
                                        {% elseif update.status == 'identified' %}
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                                                <path d="M21 21l-6 -6"></path>
                                            </svg>
                                        {% else %}
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                                                <path d="M12 8l0 4"></path>
                                                <path d="M12 16l.01 0"></path>
                                            </svg>
                                        {% endif %}
                                    </div>
                                    <div class="card timeline-event-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="badge bg-{% if update.status == 'resolved' %}success{% elseif update.status == 'monitoring' %}info{% elseif update.status == 'identified' %}warning{% else %}secondary{% endif %}">
                                                    {{ update.status_label }}
                                                </span>
                                                <small class="text-muted">{{ update.created_at|format_datetime }}</small>
                                            </div>
                                            <p class="mb-0">{{ update.message|nl2br }}</p>
                                        </div>
                                    </div>
                                </li>
                                {% endfor %}
                            </ul>
                            {% else %}
                            <div class="text-center text-muted py-4">
                                {{ 'No updates available.'|trans }}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block head %}
<style>
.timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
}
.timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--tblr-border-color);
}
.timeline-event {
    position: relative;
    padding-left: 45px;
    margin-bottom: 1rem;
}
.timeline-event:last-child {
    margin-bottom: 0;
}
.timeline-event-icon {
    position: absolute;
    left: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}
.timeline-event-icon .icon {
    width: 16px;
    height: 16px;
}
.timeline-event-card {
    box-shadow: none;
    border: 1px solid var(--tblr-border-color);
}
.datagrid-item {
    margin-bottom: 0;
}
.datagrid-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tblr-muted);
    margin-bottom: 0.25rem;
}
</style>
{% endblock %}
