{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% block meta_title %}{{ 'WHM/cPanel Importer'|trans }}{% endblock %}

{% set active_menu = 'system' %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|alink }}">
                <svg class="icon"><use xlink:href="#home" /></svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'system'|alink }}">{{ 'System'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'WHM Importer'|trans }}</li>
    </ol>
{% endblock %}

{% block content %}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">{{ 'WHM/cPanel Importer'|trans }}</h3>
    </div>
    <div class="card-body">
        <p class="text-muted">
            {{ 'This tool allows you to import packages and accounts from your cPanel/WHM servers into FOSSBilling. Select a server to begin.'|trans }}
        </p>
    </div>
</div>

{% set servers = admin.whmimporter_get_servers %}

{% if servers|length == 0 %}
<div class="alert alert-warning">
    <svg class="icon"><use xlink:href="#alert-triangle" /></svg>
    <div>
        <h4 class="alert-title">{{ 'No WHM Servers Found'|trans }}</h4>
        <div class="text-secondary">
            {{ 'You need to configure a WHM/cPanel server in the hosting module before you can import packages and accounts.'|trans }}
            <a href="{{ 'servicehosting'|alink }}">{{ 'Configure Servers'|trans }}</a>
        </div>
    </div>
</div>
{% else %}

<div class="row row-cards">
    {% for server in servers %}
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg class="icon me-2"><use xlink:href="#server" /></svg>
                    {{ server.name }}
                </h3>
                <div class="card-actions">
                    {% if server.active %}
                        <span class="badge bg-success">{{ 'Active'|trans }}</span>
                    {% else %}
                        <span class="badge bg-secondary">{{ 'Inactive'|trans }}</span>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">{{ 'Hostname'|trans }}:</dt>
                    <dd class="col-7">{{ server.hostname }}</dd>
                    <dt class="col-5">{{ 'IP Address'|trans }}:</dt>
                    <dd class="col-7">{{ server.ip }}</dd>
                </dl>
            </div>
            <div class="card-footer">
                <div class="btn-list">
                    <a href="#" class="btn btn-outline-primary btn-test-connection" data-server-id="{{ server.id }}">
                        <svg class="icon"><use xlink:href="#activity" /></svg>
                        {{ 'Test Connection'|trans }}
                    </a>
                </div>
            </div>
            <div class="card-footer">
                <div class="btn-list">
                    <a href="#" class="btn btn-primary btn-import-packages" data-server-id="{{ server.id }}" data-server-name="{{ server.name }}">
                        <svg class="icon"><use xlink:href="#package" /></svg>
                        {{ 'Import Packages'|trans }}
                    </a>
                    <a href="#" class="btn btn-success btn-import-accounts" data-server-id="{{ server.id }}" data-server-name="{{ server.name }}">
                        <svg class="icon"><use xlink:href="#users" /></svg>
                        {{ 'Import Accounts'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Cleanup/Delete Section -->
<div class="card mt-4">
    <div class="card-header">
        <h3 class="card-title">
            <svg class="icon me-2"><use xlink:href="#trash-2" /></svg>
            {{ 'Cleanup & Delete Imported Data'|trans }}
        </h3>
    </div>
    <div class="card-body">
        <div class="alert alert-danger">
            <svg class="icon"><use xlink:href="#alert-triangle" /></svg>
            <div>
                <h4 class="alert-title">{{ 'Danger Zone'|trans }}</h4>
                <div class="text-secondary">
                    {{ 'These actions are irreversible. Make sure you have backups before proceeding.'|trans }}
                </div>
            </div>
        </div>

        <div class="row row-cards">
            <div class="col-md-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar bg-danger text-white me-3">
                                <svg class="icon"><use xlink:href="#server" /></svg>
                            </span>
                            <div>
                                <div class="fw-bold">{{ 'Delete Hosting Services'|trans }}</div>
                                <div class="text-secondary small">{{ 'Delete all hosting accounts and orders'|trans }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-outline-danger btn-sm btn-delete-services">
                            <svg class="icon"><use xlink:href="#trash-2" /></svg>
                            {{ 'Delete Services'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar bg-warning text-white me-3">
                                <svg class="icon"><use xlink:href="#users" /></svg>
                            </span>
                            <div>
                                <div class="fw-bold">{{ 'Delete Imported Clients'|trans }}</div>
                                <div class="text-secondary small">{{ 'Delete clients with hosting services'|trans }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-outline-warning btn-sm btn-delete-clients">
                            <svg class="icon"><use xlink:href="#trash-2" /></svg>
                            {{ 'Delete Clients'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar bg-info text-white me-3">
                                <svg class="icon"><use xlink:href="#package" /></svg>
                            </span>
                            <div>
                                <div class="fw-bold">{{ 'Delete Hosting Products'|trans }}</div>
                                <div class="text-secondary small">{{ 'Delete hosting product catalog'|trans }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-outline-info btn-sm btn-delete-products">
                            <svg class="icon"><use xlink:href="#trash-2" /></svg>
                            {{ 'Delete Products'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar bg-secondary text-white me-3">
                                <svg class="icon"><use xlink:href="#layers" /></svg>
                            </span>
                            <div>
                                <div class="fw-bold">{{ 'Delete Hosting Plans'|trans }}</div>
                                <div class="text-secondary small">{{ 'Delete hosting plan configurations'|trans }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-outline-secondary btn-sm btn-delete-plans">
                            <svg class="icon"><use xlink:href="#trash-2" /></svg>
                            {{ 'Delete Plans'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-end">
            <a href="#" class="btn btn-danger btn-delete-all">
                <svg class="icon"><use xlink:href="#alert-octagon" /></svg>
                {{ 'Delete Everything (Full Reset)'|trans }}
            </a>
        </div>
    </div>
</div>

<!-- Import Packages Modal -->
<div class="modal modal-blur fade" id="importPackagesModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Import Packages from WHM'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="packagesLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">{{ 'Loading packages from WHM server...'|trans }}</p>
                </div>
                <div id="packagesContent" style="display: none;">
                    <div class="alert alert-info mb-3">
                        <svg class="icon"><use xlink:href="#info-circle" /></svg>
                        {{ 'Select the packages you want to import as hosting plans in FOSSBilling.'|trans }}
                    </div>
                    <div class="mb-3">
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" id="selectAllPackages">
                            <span class="form-check-label fw-bold">{{ 'Select All'|trans }}</span>
                        </label>
                    </div>
                    <div id="packagesList" class="list-group list-group-flush"></div>
                </div>
                <div id="packagesError" class="alert alert-danger" style="display: none;"></div>
                <input type="hidden" id="packagesServerId" value="">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="button" class="btn btn-primary" id="btnDoImportPackages">
                    <svg class="icon"><use xlink:href="#download" /></svg>
                    {{ 'Import Selected Packages'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Import Accounts Modal -->
<div class="modal modal-blur fade" id="importAccountsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Import Accounts from WHM'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="accountsLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">{{ 'Loading accounts from WHM server...'|trans }}</p>
                </div>
                <div id="accountsContent" style="display: none;">
                    <div class="alert alert-info mb-3">
                        <svg class="icon"><use xlink:href="#info-circle" /></svg>
                        {{ 'Select the accounts you want to import. Each account will be automatically assigned to its corresponding cPanel package. If the package does not exist in FOSSBilling, it will be created.'|trans }}
                    </div>

                    <div class="alert alert-warning mb-3">
                        <svg class="icon"><use xlink:href="#alert-triangle" /></svg>
                        <div>
                            <strong>{{ 'About account types'|trans }}:</strong>
                            <ul class="mb-0 mt-1">
                                <li><span class="badge bg-purple">Reseller</span> - {{ 'A reseller is a single product that can contain its own sub-accounts.'|trans }}</li>
                                <li><span class="badge bg-info">Sub-account</span> - {{ 'These accounts belong to a reseller and are NOT separate products. They should generally NOT be imported.'|trans }}</li>
                                <li><span class="badge bg-secondary">Standard</span> - {{ 'Regular hosting accounts owned directly by root.'|trans }}</li>
                            </ul>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">{{ 'Client Group'|trans }}</label>
                            <select class="form-select" id="accountsClientGroup">
                                <option value="1">{{ 'Default'|trans }}</option>
                            </select>
                            <small class="text-muted">{{ 'New clients will be added to this group.'|trans }}</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">{{ 'If client email already exists'|trans }}</label>
                            <select class="form-select" id="accountsDuplicateAction">
                                <option value="use_existing">{{ 'Use existing client'|trans }}</option>
                                <option value="update_existing">{{ 'Update existing client data'|trans }}</option>
                                <option value="create_new">{{ 'Create new client (add suffix to email)'|trans }}</option>
                            </select>
                            <small class="text-muted">{{ 'Action for duplicate client emails.'|trans }}</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">{{ 'If hosting account already exists'|trans }}</label>
                            <select class="form-select" id="accountsAccountDuplicateAction">
                                <option value="update" selected>{{ 'Update existing account'|trans }}</option>
                                <option value="recreate">{{ 'Delete and recreate account'|trans }}</option>
                                <option value="skip">{{ 'Skip (do not import)'|trans }}</option>
                            </select>
                            <small class="text-muted">{{ 'Action for duplicate hosting accounts.'|trans }}</small>
                        </div>
                    </div>

                    <div class="alert alert-primary mb-3">
                        <label class="form-check mb-0">
                            <input type="checkbox" class="form-check-input" id="skipSubAccounts" checked>
                            <span class="form-check-label">
                                <strong>{{ 'Automatically skip sub-accounts (recommended)'|trans }}</strong>
                                <div class="text-secondary small">{{ 'Sub-accounts belong to reseller contracts and are not independent billable products. Only the reseller account itself represents the contractual relationship.'|trans }}</div>
                            </span>
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" id="selectAllAccounts">
                            <span class="form-check-label fw-bold">{{ 'Select All'|trans }}</span>
                        </label>
                    </div>

                    <div class="mb-3">
                        <div class="btn-group" role="group" aria-label="Account filter">
                            <input type="radio" class="btn-check" name="accountFilter" id="filterAll" value="all" checked>
                            <label class="btn btn-outline-primary" for="filterAll">{{ 'All'|trans }}</label>

                            <input type="radio" class="btn-check" name="accountFilter" id="filterDirect" value="direct">
                            <label class="btn btn-outline-success" for="filterDirect">{{ 'Direct Accounts (Recommended)'|trans }}</label>

                            <input type="radio" class="btn-check" name="accountFilter" id="filterResellers" value="reseller">
                            <label class="btn btn-outline-purple" for="filterResellers">{{ 'Resellers Only'|trans }}</label>

                            <input type="radio" class="btn-check" name="accountFilter" id="filterStandard" value="standard">
                            <label class="btn btn-outline-secondary" for="filterStandard">{{ 'Standard Only'|trans }}</label>

                            <input type="radio" class="btn-check" name="accountFilter" id="filterSubaccounts" value="subaccount">
                            <label class="btn btn-outline-info" for="filterSubaccounts">{{ 'Sub-accounts'|trans }}</label>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr>
                                    <th class="w-1"></th>
                                    <th>{{ 'Domain'|trans }}</th>
                                    <th>{{ 'Username'|trans }}</th>
                                    <th>{{ 'Type'|trans }}</th>
                                    <th>{{ 'Owner'|trans }}</th>
                                    <th>{{ 'Email'|trans }}</th>
                                    <th>{{ 'Plan'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody id="accountsList"></tbody>
                        </table>
                    </div>
                </div>
                <div id="accountsError" class="alert alert-danger" style="display: none;"></div>
                <input type="hidden" id="accountsServerId" value="">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="button" class="btn btn-success" id="btnDoImportAccounts">
                    <svg class="icon"><use xlink:href="#download" /></svg>
                    {{ 'Import Selected Accounts'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Results Modal -->
<div class="modal modal-blur fade" id="resultsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resultsModalTitle">{{ 'Import Results'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="resultsModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
            </div>
        </div>
    </div>
</div>

{% endif %}
{% endblock %}

{% block head %}
<style>
    .btn-outline-purple {
        color: #6f42c1;
        border-color: #6f42c1;
    }
    .btn-outline-purple:hover,
    .btn-check:checked + .btn-outline-purple {
        color: #fff;
        background-color: #6f42c1;
        border-color: #6f42c1;
    }
</style>
{% endblock %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const importPackagesModal = new bootstrap.Modal(document.getElementById('importPackagesModal'));
    const importAccountsModal = new bootstrap.Modal(document.getElementById('importAccountsModal'));
    const resultsModal = new bootstrap.Modal(document.getElementById('resultsModal'));

    // Function to render accounts list
    function renderAccountsList(accounts) {
        let html = '';
        accounts.forEach(acct => {
            const statusBadge = acct.suspended
                ? '<span class="badge bg-danger">Suspended</span>'
                : '<span class="badge bg-success">Active</span>';

            let typeBadge;
            if (acct.is_reseller) {
                typeBadge = '<span class="badge bg-purple">Reseller</span>';
            } else if (acct.is_owned_by_reseller) {
                typeBadge = '<span class="badge bg-info">Sub-account</span>';
            } else {
                typeBadge = '<span class="badge bg-secondary">Standard</span>';
            }

            html += `
                <tr data-is-reseller="${acct.is_reseller}" data-owner="${acct.owner}">
                    <td>
                        <input class="form-check-input account-checkbox" type="checkbox" value="${acct.user}">
                    </td>
                    <td>${acct.domain}</td>
                    <td><code>${acct.user}</code></td>
                    <td>${typeBadge}</td>
                    <td>${acct.owner}</td>
                    <td>${acct.email || '-'}</td>
                    <td>${acct.plan}</td>
                    <td>${statusBadge}</td>
                </tr>
            `;
        });

        if (accounts.length === 0) {
            html = '<tr><td colspan="8" class="text-center text-muted">No accounts found matching the filter.</td></tr>';
        }

        document.getElementById('accountsList').innerHTML = html;
    }

    // Function to filter accounts
    function filterAccounts(filterType) {
        if (!window.accountsData) return;

        let filtered;
        switch (filterType) {
            case 'direct':
                // Direct accounts: owned by root (resellers + standard), excludes sub-accounts
                filtered = window.accountsData.filter(a => !a.is_owned_by_reseller);
                break;
            case 'reseller':
                // Reseller accounts only
                filtered = window.accountsData.filter(a => a.is_reseller);
                break;
            case 'standard':
                // Standard accounts: owned by root and NOT resellers
                filtered = window.accountsData.filter(a => !a.is_reseller && !a.is_owned_by_reseller);
                break;
            case 'subaccount':
                // Sub-accounts: owned by a reseller (NOT root)
                filtered = window.accountsData.filter(a => a.is_owned_by_reseller);
                break;
            default:
                filtered = window.accountsData;
        }

        renderAccountsList(filtered);

        // Update select all checkbox state
        document.getElementById('selectAllAccounts').checked = false;
    }

    // Make functions globally available
    window.renderAccountsList = renderAccountsList;
    window.filterAccounts = filterAccounts;

    // Test Connection
    document.querySelectorAll('.btn-test-connection').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const serverId = this.dataset.serverId;
            const button = this;

            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Testing...';

            API.admin.post('whmimporter/test_connection', { server_id: serverId }, function(result) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#check" /></svg> Connected!';
                button.classList.remove('btn-outline-primary');
                button.classList.add('btn-success');
                setTimeout(() => {
                    button.innerHTML = '<svg class="icon"><use xlink:href="#activity" /></svg> Test Connection';
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-primary');
                }, 3000);
            }, function(error) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#x" /></svg> Failed';
                button.classList.remove('btn-outline-primary');
                button.classList.add('btn-danger');
                setTimeout(() => {
                    button.innerHTML = '<svg class="icon"><use xlink:href="#activity" /></svg> Test Connection';
                    button.classList.remove('btn-danger');
                    button.classList.add('btn-outline-primary');
                }, 3000);
            });
        });
    });

    // Import Packages - Open Modal
    document.querySelectorAll('.btn-import-packages').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const serverId = this.dataset.serverId;

            document.getElementById('packagesServerId').value = serverId;
            document.getElementById('packagesLoading').style.display = 'block';
            document.getElementById('packagesContent').style.display = 'none';
            document.getElementById('packagesError').style.display = 'none';
            document.getElementById('packagesList').innerHTML = '';

            importPackagesModal.show();

            API.admin.post('whmimporter/get_remote_packages', { server_id: serverId }, function(packages) {
                document.getElementById('packagesLoading').style.display = 'none';
                document.getElementById('packagesContent').style.display = 'block';

                let html = '';
                packages.forEach(pkg => {
                    html += `
                        <label class="list-group-item">
                            <input class="form-check-input me-2 package-checkbox" type="checkbox" value="${pkg.name}">
                            <span class="fw-bold">${pkg.name}</span>
                            <small class="text-muted ms-2">
                                Quota: ${pkg.quota} | BW: ${pkg.bandwidth} | FTP: ${pkg.max_ftp} | SQL: ${pkg.max_sql}
                            </small>
                        </label>
                    `;
                });

                if (packages.length === 0) {
                    html = '<div class="text-center text-muted py-3">No packages found on this server.</div>';
                }

                document.getElementById('packagesList').innerHTML = html;
            }, function(error) {
                document.getElementById('packagesLoading').style.display = 'none';
                document.getElementById('packagesError').style.display = 'block';
                document.getElementById('packagesError').textContent = typeof error === 'object' ? (error.message || error.error || JSON.stringify(error)) : error;
            });
        });
    });

    // Select All Packages
    document.getElementById('selectAllPackages').addEventListener('change', function() {
        document.querySelectorAll('.package-checkbox').forEach(cb => {
            cb.checked = this.checked;
        });
    });

    // Do Import Packages
    document.getElementById('btnDoImportPackages').addEventListener('click', function() {
        const serverId = document.getElementById('packagesServerId').value;
        const selectedPackages = [];

        document.querySelectorAll('.package-checkbox:checked').forEach(cb => {
            selectedPackages.push(cb.value);
        });

        if (selectedPackages.length === 0) {
            alert('Please select at least one package to import.');
            return;
        }

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Importing...';

        API.admin.post('whmimporter/import_packages', {
            server_id: serverId,
            packages: JSON.stringify(selectedPackages)
        }, function(result) {
            importPackagesModal.hide();

            let html = '<div class="mb-3">';

            if (result.imported.length > 0) {
                html += '<h6 class="text-success"><svg class="icon"><use xlink:href="#check" /></svg> Imported (' + result.imported.length + ')</h6>';
                html += '<ul class="list-unstyled">';
                result.imported.forEach(pkg => {
                    html += '<li>' + pkg.name + '</li>';
                });
                html += '</ul>';
            }

            if (result.skipped.length > 0) {
                html += '<h6 class="text-warning"><svg class="icon"><use xlink:href="#alert-triangle" /></svg> Skipped (already exist)</h6>';
                html += '<ul class="list-unstyled">';
                result.skipped.forEach(name => {
                    html += '<li>' + name + '</li>';
                });
                html += '</ul>';
            }

            html += '</div>';

            document.getElementById('resultsModalTitle').textContent = 'Package Import Results';
            document.getElementById('resultsModalBody').innerHTML = html;
            resultsModal.show();

            document.getElementById('btnDoImportPackages').disabled = false;
            document.getElementById('btnDoImportPackages').innerHTML = '<svg class="icon"><use xlink:href="#download" /></svg> Import Selected Packages';
        }, function(error) {
            alert('Import failed: ' + error);
            document.getElementById('btnDoImportPackages').disabled = false;
            document.getElementById('btnDoImportPackages').innerHTML = '<svg class="icon"><use xlink:href="#download" /></svg> Import Selected Packages';
        });
    });

    // Import Accounts - Open Modal
    document.querySelectorAll('.btn-import-accounts').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const serverId = this.dataset.serverId;

            document.getElementById('accountsServerId').value = serverId;
            document.getElementById('accountsLoading').style.display = 'block';
            document.getElementById('accountsContent').style.display = 'none';
            document.getElementById('accountsError').style.display = 'none';
            document.getElementById('accountsList').innerHTML = '';

            importAccountsModal.show();

            // Load client groups
            API.admin.post('whmimporter/get_client_groups', {}, function(groups) {
                const select = document.getElementById('accountsClientGroup');
                select.innerHTML = '';
                groups.forEach(group => {
                    select.innerHTML += `<option value="${group.id}">${group.title}</option>`;
                });
            });

            // Load accounts
            API.admin.post('whmimporter/get_remote_accounts', { server_id: serverId }, function(accounts) {
                document.getElementById('accountsLoading').style.display = 'none';
                document.getElementById('accountsContent').style.display = 'block';

                // Store accounts data for filtering
                window.accountsData = accounts;
                renderAccountsList(accounts);

                // Setup filter handlers
                document.querySelectorAll('input[name="accountFilter"]').forEach(radio => {
                    radio.addEventListener('change', function() {
                        filterAccounts(this.value);
                    });
                });
            }, function(error) {
                document.getElementById('accountsLoading').style.display = 'none';
                document.getElementById('accountsError').style.display = 'block';
                document.getElementById('accountsError').textContent = typeof error === 'object' ? (error.message || error.error || JSON.stringify(error)) : error;
            });
        });
    });

    // Select All Accounts
    document.getElementById('selectAllAccounts').addEventListener('change', function() {
        document.querySelectorAll('.account-checkbox').forEach(cb => {
            cb.checked = this.checked;
        });
    });

    // Do Import Accounts
    document.getElementById('btnDoImportAccounts').addEventListener('click', function() {
        const serverId = document.getElementById('accountsServerId').value;
        const clientGroupId = document.getElementById('accountsClientGroup').value;
        const duplicateAction = document.getElementById('accountsDuplicateAction').value;
        const accountDuplicateAction = document.getElementById('accountsAccountDuplicateAction').value;
        const skipSubAccounts = document.getElementById('skipSubAccounts').checked;

        const selectedAccounts = [];
        document.querySelectorAll('.account-checkbox:checked').forEach(cb => {
            selectedAccounts.push(cb.value);
        });

        if (selectedAccounts.length === 0) {
            alert('Please select at least one account to import.');
            return;
        }

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Importing...';

        API.admin.post('whmimporter/import_accounts', {
            server_id: serverId,
            usernames: JSON.stringify(selectedAccounts),
            client_group_id: clientGroupId,
            duplicate_action: duplicateAction,
            account_duplicate_action: accountDuplicateAction,
            skip_sub_accounts: skipSubAccounts ? 1 : 0
        }, function(result) {
            importAccountsModal.hide();

            let html = '<div class="mb-3">';

            if (result.plans_created && result.plans_created.length > 0) {
                html += '<h6 class="text-info"><svg class="icon"><use xlink:href="#package" /></svg> Hosting Plans Created (' + result.plans_created.length + ')</h6>';
                html += '<ul class="list-unstyled">';
                result.plans_created.forEach(planId => {
                    html += '<li>Plan ID: ' + planId + '</li>';
                });
                html += '</ul>';
            }

            if (result.imported.length > 0) {
                // Separate new imports from updates
                const newImports = result.imported.filter(acct => acct.action !== 'updated');
                const updatedImports = result.imported.filter(acct => acct.action === 'updated');

                if (newImports.length > 0) {
                    html += '<h6 class="text-success"><svg class="icon"><use xlink:href="#check" /></svg> Imported (' + newImports.length + ')</h6>';
                    html += '<ul class="list-unstyled">';
                    newImports.forEach(acct => {
                        const resellerBadge = acct.is_reseller ? ' <span class="badge bg-purple">Reseller</span>' : '';
                        const planBadge = acct.plan ? ' <span class="badge bg-info">' + acct.plan + '</span>' : '';
                        html += '<li><strong>' + acct.username + '</strong> - ' + acct.domain + resellerBadge + planBadge + '</li>';
                    });
                    html += '</ul>';
                }

                if (updatedImports.length > 0) {
                    html += '<h6 class="text-primary"><svg class="icon"><use xlink:href="#refresh-cw" /></svg> Updated (' + updatedImports.length + ')</h6>';
                    html += '<ul class="list-unstyled">';
                    updatedImports.forEach(acct => {
                        const resellerBadge = acct.is_reseller ? ' <span class="badge bg-purple">Reseller</span>' : '';
                        const planBadge = acct.plan ? ' <span class="badge bg-info">' + acct.plan + '</span>' : '';
                        html += '<li><strong>' + acct.username + '</strong> - ' + acct.domain + resellerBadge + planBadge + '</li>';
                    });
                    html += '</ul>';
                }
            }

            if (result.skipped.length > 0) {
                html += '<h6 class="text-warning"><svg class="icon"><use xlink:href="#alert-triangle" /></svg> Skipped (already exist)</h6>';
                html += '<ul class="list-unstyled">';
                result.skipped.forEach(username => {
                    html += '<li>' + username + '</li>';
                });
                html += '</ul>';
            }

            if (result.skipped_sub_accounts && result.skipped_sub_accounts.length > 0) {
                html += '<h6 class="text-info"><svg class="icon"><use xlink:href="#info" /></svg> Sub-accounts skipped (' + result.skipped_sub_accounts.length + ')</h6>';
                html += '<div class="small text-muted mb-2">{{ 'These accounts belong to reseller contracts and are not independent products.'|trans }}</div>';
                html += '<ul class="list-unstyled">';
                result.skipped_sub_accounts.forEach(acct => {
                    html += '<li><strong>' + acct.username + '</strong> - ' + acct.domain + ' <span class="badge bg-secondary">{{ 'Owner'|trans }}: ' + acct.owner + '</span></li>';
                });
                html += '</ul>';
            }

            if (result.errors.length > 0) {
                html += '<h6 class="text-danger"><svg class="icon"><use xlink:href="#x" /></svg> Errors</h6>';
                html += '<ul class="list-unstyled">';
                result.errors.forEach(err => {
                    html += '<li><strong>' + err.username + '</strong>: ' + err.error + '</li>';
                });
                html += '</ul>';
            }

            html += '</div>';

            document.getElementById('resultsModalTitle').textContent = 'Account Import Results';
            document.getElementById('resultsModalBody').innerHTML = html;
            resultsModal.show();

            document.getElementById('btnDoImportAccounts').disabled = false;
            document.getElementById('btnDoImportAccounts').innerHTML = '<svg class="icon"><use xlink:href="#download" /></svg> Import Selected Accounts';
        }, function(error) {
            alert('Import failed: ' + error);
            document.getElementById('btnDoImportAccounts').disabled = false;
            document.getElementById('btnDoImportAccounts').innerHTML = '<svg class="icon"><use xlink:href="#download" /></svg> Import Selected Accounts';
        });
    });

    // Delete Services
    document.querySelectorAll('.btn-delete-services').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!confirm('{{ 'Are you sure you want to delete ALL hosting services and their orders? This action cannot be undone!'|trans }}')) {
                return;
            }

            const button = this;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> {{ 'Deleting...'|trans }}';

            API.admin.post('whmimporter/delete_hosting_services', {}, function(result) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Services'|trans }}';

                let html = '<div class="mb-3">';
                html += '<h6 class="text-success">{{ 'Deleted'|trans }} (' + result.deleted_count + ' {{ 'services'|trans }})</h6>';
                if (result.deleted.length > 0 && result.deleted.length <= 10) {
                    html += '<ul class="list-unstyled">';
                    result.deleted.forEach(item => {
                        html += '<li>' + item.username + ' - ' + item.domain + '</li>';
                    });
                    html += '</ul>';
                }
                if (result.errors.length > 0) {
                    html += '<h6 class="text-danger">{{ 'Errors'|trans }}</h6>';
                    html += '<ul class="list-unstyled">';
                    result.errors.forEach(err => {
                        html += '<li>' + err.username + ': ' + err.error + '</li>';
                    });
                    html += '</ul>';
                }
                html += '</div>';

                document.getElementById('resultsModalTitle').textContent = '{{ 'Delete Results'|trans }}';
                document.getElementById('resultsModalBody').innerHTML = html;
                resultsModal.show();
            }, function(error) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Services'|trans }}';
                alert('{{ 'Error'|trans }}: ' + error);
            });
        });
    });

    // Delete Clients
    document.querySelectorAll('.btn-delete-clients').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!confirm('{{ 'Are you sure you want to delete ALL clients with hosting services? This will also delete their orders and services. This action cannot be undone!'|trans }}')) {
                return;
            }

            const button = this;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> {{ 'Deleting...'|trans }}';

            API.admin.post('whmimporter/delete_clients', { only_imported: true }, function(result) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Clients'|trans }}';

                let html = '<div class="mb-3">';
                html += '<h6 class="text-success">{{ 'Deleted'|trans }} (' + result.deleted_count + ' {{ 'clients'|trans }})</h6>';
                if (result.deleted.length > 0 && result.deleted.length <= 10) {
                    html += '<ul class="list-unstyled">';
                    result.deleted.forEach(item => {
                        html += '<li>' + item.email + ' - ' + item.name + '</li>';
                    });
                    html += '</ul>';
                }
                if (result.errors.length > 0) {
                    html += '<h6 class="text-danger">{{ 'Errors'|trans }}</h6>';
                    html += '<ul class="list-unstyled">';
                    result.errors.forEach(err => {
                        html += '<li>ID ' + err.id + ': ' + err.error + '</li>';
                    });
                    html += '</ul>';
                }
                html += '</div>';

                document.getElementById('resultsModalTitle').textContent = '{{ 'Delete Results'|trans }}';
                document.getElementById('resultsModalBody').innerHTML = html;
                resultsModal.show();
            }, function(error) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Clients'|trans }}';
                alert('{{ 'Error'|trans }}: ' + error);
            });
        });
    });

    // Delete Products
    document.querySelectorAll('.btn-delete-products').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!confirm('{{ 'Are you sure you want to delete ALL hosting products? Products in use cannot be deleted. This action cannot be undone!'|trans }}')) {
                return;
            }

            const button = this;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> {{ 'Deleting...'|trans }}';

            API.admin.post('whmimporter/delete_hosting_products', {}, function(result) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Products'|trans }}';

                let html = '<div class="mb-3">';
                html += '<h6 class="text-success">{{ 'Deleted'|trans }} (' + result.deleted_count + ' {{ 'products'|trans }})</h6>';
                if (result.deleted.length > 0 && result.deleted.length <= 10) {
                    html += '<ul class="list-unstyled">';
                    result.deleted.forEach(item => {
                        html += '<li>' + item.title + '</li>';
                    });
                    html += '</ul>';
                }
                if (result.errors.length > 0) {
                    html += '<h6 class="text-warning">{{ 'Skipped (in use)'|trans }}</h6>';
                    html += '<ul class="list-unstyled">';
                    result.errors.forEach(err => {
                        html += '<li>' + err.title + ': ' + err.error + '</li>';
                    });
                    html += '</ul>';
                }
                html += '</div>';

                document.getElementById('resultsModalTitle').textContent = '{{ 'Delete Results'|trans }}';
                document.getElementById('resultsModalBody').innerHTML = html;
                resultsModal.show();
            }, function(error) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Products'|trans }}';
                alert('{{ 'Error'|trans }}: ' + error);
            });
        });
    });

    // Delete Plans
    document.querySelectorAll('.btn-delete-plans').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!confirm('{{ 'Are you sure you want to delete ALL hosting plans? Plans in use cannot be deleted. This action cannot be undone!'|trans }}')) {
                return;
            }

            const button = this;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> {{ 'Deleting...'|trans }}';

            API.admin.post('whmimporter/delete_hosting_plans', {}, function(result) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Plans'|trans }}';

                let html = '<div class="mb-3">';
                html += '<h6 class="text-success">{{ 'Deleted'|trans }} (' + result.deleted_count + ' {{ 'plans'|trans }})</h6>';
                if (result.deleted.length > 0 && result.deleted.length <= 10) {
                    html += '<ul class="list-unstyled">';
                    result.deleted.forEach(item => {
                        html += '<li>' + item.name + '</li>';
                    });
                    html += '</ul>';
                }
                if (result.errors.length > 0) {
                    html += '<h6 class="text-warning">{{ 'Skipped (in use)'|trans }}</h6>';
                    html += '<ul class="list-unstyled">';
                    result.errors.forEach(err => {
                        html += '<li>' + err.name + ': ' + err.error + '</li>';
                    });
                    html += '</ul>';
                }
                html += '</div>';

                document.getElementById('resultsModalTitle').textContent = '{{ 'Delete Results'|trans }}';
                document.getElementById('resultsModalBody').innerHTML = html;
                resultsModal.show();
            }, function(error) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#trash-2" /></svg> {{ 'Delete Plans'|trans }}';
                alert('{{ 'Error'|trans }}: ' + error);
            });
        });
    });

    // Delete All
    document.querySelectorAll('.btn-delete-all').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!confirm('{{ 'WARNING: This will delete ALL hosting services, imported clients, products, and plans! Are you absolutely sure?'|trans }}')) {
                return;
            }
            if (!confirm('{{ 'This is your last chance to cancel. Type DELETE in the next prompt to confirm.'|trans }}')) {
                return;
            }

            const confirmation = prompt('{{ 'Type DELETE to confirm complete deletion:'|trans }}');
            if (confirmation !== 'DELETE') {
                alert('{{ 'Deletion cancelled.'|trans }}');
                return;
            }

            const button = this;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> {{ 'Deleting everything...'|trans }}';

            API.admin.post('whmimporter/delete_all', {}, function(result) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#alert-octagon" /></svg> {{ 'Delete Everything (Full Reset)'|trans }}';

                let html = '<div class="mb-3">';
                html += '<h5 class="text-success mb-3">{{ 'Complete cleanup finished!'|trans }}</h5>';
                html += '<table class="table table-sm">';
                html += '<tr><td>{{ 'Services deleted'|trans }}</td><td class="text-end"><strong>' + result.services.deleted_count + '</strong></td></tr>';
                html += '<tr><td>{{ 'Clients deleted'|trans }}</td><td class="text-end"><strong>' + result.clients.deleted_count + '</strong></td></tr>';
                html += '<tr><td>{{ 'Products deleted'|trans }}</td><td class="text-end"><strong>' + result.products.deleted_count + '</strong></td></tr>';
                html += '<tr><td>{{ 'Plans deleted'|trans }}</td><td class="text-end"><strong>' + result.plans.deleted_count + '</strong></td></tr>';
                html += '<tr class="table-success"><td><strong>{{ 'Total deleted'|trans }}</strong></td><td class="text-end"><strong>' + result.total_deleted + '</strong></td></tr>';
                html += '</table>';
                html += '</div>';

                document.getElementById('resultsModalTitle').textContent = '{{ 'Complete Cleanup Results'|trans }}';
                document.getElementById('resultsModalBody').innerHTML = html;
                resultsModal.show();
            }, function(error) {
                button.disabled = false;
                button.innerHTML = '<svg class="icon"><use xlink:href="#alert-octagon" /></svg> {{ 'Delete Everything (Full Reset)'|trans }}';
                alert('{{ 'Error'|trans }}: ' + error);
            });
        });
    });
});
</script>
{% endblock %}
