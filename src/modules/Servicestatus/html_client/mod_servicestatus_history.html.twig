{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Incident History'|trans }} - {{ 'System Status'|trans }}{% endblock %}

{% block body_class %}status-history{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ '/status'|link }}">{{ 'System Status'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'History'|trans }}</li>
{% endblock %}

{% block content %}
    {% set incidents = guest.servicestatus_incident_get_recent({'days': 90}) %}

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0">{{ 'Incident History'|trans }}</h1>
                    <a href="{{ '/status'|link }}" class="btn btn-outline-primary">
                        &larr; {{ 'Back to Status'|trans }}
                    </a>
                </div>

                {% if incidents|length > 0 %}
                    {% set grouped_incidents = {} %}
                    {% for incident in incidents %}
                        {% set month_key = incident.created_at|date('Y-m') %}
                        {% if grouped_incidents[month_key] is not defined %}
                            {% set grouped_incidents = grouped_incidents|merge({(month_key): []}) %}
                        {% endif %}
                        {% set grouped_incidents = grouped_incidents|merge({(month_key): grouped_incidents[month_key]|merge([incident])}) %}
                    {% endfor %}

                    {% for month_key, month_incidents in grouped_incidents %}
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">{{ month_key|date('F Y') }}</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush">
                                {% for incident in month_incidents %}
                                <a href="{{ '/status/incident'|link }}/{{ incident.id }}" class="list-group-item list-group-item-action">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">{{ incident.title }}</h6>
                                            <small class="text-muted">
                                                {{ incident.created_at|format_datetime }}
                                                {% if incident.is_scheduled %}
                                                    <span class="badge bg-info ms-1">{{ 'Maintenance'|trans }}</span>
                                                {% endif %}
                                            </small>
                                            {% if incident.components|length > 0 %}
                                            <div class="mt-1">
                                                {% for comp in incident.components %}
                                                    <span class="badge bg-secondary small">{{ comp.name }}</span>
                                                {% endfor %}
                                            </div>
                                            {% endif %}
                                        </div>
                                        <span class="badge bg-{% if incident.is_resolved %}success{% else %}warning{% endif %}">
                                            {{ incident.status_label }}
                                        </span>
                                    </div>
                                </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success mb-3">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            <h4>{{ 'No incidents in the past 90 days'|trans }}</h4>
                            <p class="text-muted">{{ 'All systems have been operating normally.'|trans }}</p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
