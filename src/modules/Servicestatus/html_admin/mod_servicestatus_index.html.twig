{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'system' %}

{% block meta_title %}{{ 'Service Status'|trans }}{% endblock %}

{% block content %}
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" href="#tab-components" data-bs-toggle="tab" role="tab">{{ 'Components'|trans }}</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tab-incidents" data-bs-toggle="tab" role="tab">{{ 'Incidents'|trans }}</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tab-new-component" data-bs-toggle="tab" role="tab">
                <svg class="icon me-2">
                    <use xlink:href="#plus" />
                </svg>
                {{ 'New Component'|trans }}
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tab-new-incident" data-bs-toggle="tab" role="tab">
                <svg class="icon me-2">
                    <use xlink:href="#plus" />
                </svg>
                {{ 'New Incident'|trans }}
            </a>
        </li>
    </ul>

<div class="card">
    <div class="tab-content">
        {# Components Tab #}
        <div class="tab-pane fade show active" id="tab-components" role="tabpanel">
            <table class="table card-table table-vcenter table-striped text-nowrap">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>{{ 'Name'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th>{{ 'Order'|trans }}</th>
                        <th>{{ 'Visible'|trans }}</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    {% set components = admin.servicestatus_component_list %}
                    {% for component in components %}
                    <tr>
                        <td>{{ component.id }}</td>
                        <td>
                            <a href="{{ '/servicestatus/component'|alink }}/{{ component.id }}">{{ component.name }}</a>
                        </td>
                        <td>
                            {% if component.status == 'operational' %}
                                <span class="badge bg-success">{{ 'Operational'|trans }}</span>
                            {% elseif component.status == 'degraded_performance' %}
                                <span class="badge bg-warning">{{ 'Degraded'|trans }}</span>
                            {% elseif component.status == 'partial_outage' %}
                                <span class="badge bg-orange">{{ 'Partial Outage'|trans }}</span>
                            {% elseif component.status == 'major_outage' %}
                                <span class="badge bg-danger">{{ 'Major Outage'|trans }}</span>
                            {% elseif component.status == 'maintenance' %}
                                <span class="badge bg-info">{{ 'Maintenance'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{{ component.display_order }}</td>
                        <td>
                            {% if component.is_visible %}
                                <span class="badge bg-success">{{ 'Yes'|trans }}</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ 'No'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a class="btn btn-icon" href="{{ '/servicestatus/component'|alink }}/{{ component.id }}">
                                <svg class="icon">
                                    <use xlink:href="#edit" />
                                </svg>
                            </a>
                            <a class="btn btn-icon api-link"
                                href="{{ 'api/admin/servicestatus/component_delete'|link({ 'id': component.id, 'CSRFToken': CSRFToken }) }}"
                                data-api-confirm="{{ 'Are you sure?'|trans }}"
                                data-api-redirect="{{ 'servicestatus'|alink }}">
                                <svg class="icon">
                                    <use xlink:href="#delete" />
                                </svg>
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td class="text-muted" colspan="6">{{ 'No components created yet'|trans }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Incidents Tab #}
        <div class="tab-pane fade" id="tab-incidents" role="tabpanel">
            <table class="table card-table table-vcenter table-striped text-nowrap">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>{{ 'Title'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th>{{ 'Impact'|trans }}</th>
                        <th>{{ 'Created'|trans }}</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    {% set incidents = admin.servicestatus_incident_list %}
                    {% for incident in incidents %}
                    <tr>
                        <td>{{ incident.id }}</td>
                        <td>
                            <a href="{{ '/servicestatus/incident'|alink }}/{{ incident.id }}">{{ incident.title }}</a>
                        </td>
                        <td>
                            {% if incident.status == 'investigating' %}
                                <span class="badge bg-warning">{{ 'Investigating'|trans }}</span>
                            {% elseif incident.status == 'identified' %}
                                <span class="badge bg-info">{{ 'Identified'|trans }}</span>
                            {% elseif incident.status == 'monitoring' %}
                                <span class="badge bg-primary">{{ 'Monitoring'|trans }}</span>
                            {% elseif incident.status == 'resolved' %}
                                <span class="badge bg-success">{{ 'Resolved'|trans }}</span>
                            {% elseif incident.status == 'scheduled' %}
                                <span class="badge bg-secondary">{{ 'Scheduled'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if incident.impact == 'major_outage' %}
                                <span class="badge bg-danger">{{ 'Major'|trans }}</span>
                            {% elseif incident.impact == 'partial_outage' %}
                                <span class="badge bg-orange">{{ 'Partial'|trans }}</span>
                            {% elseif incident.impact == 'degraded_performance' %}
                                <span class="badge bg-warning">{{ 'Degraded'|trans }}</span>
                            {% elseif incident.impact == 'maintenance' %}
                                <span class="badge bg-info">{{ 'Maintenance'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{{ incident.created_at|format_datetime }}</td>
                        <td>
                            <a class="btn btn-icon" href="{{ '/servicestatus/incident'|alink }}/{{ incident.id }}">
                                <svg class="icon">
                                    <use xlink:href="#edit" />
                                </svg>
                            </a>
                            <a class="btn btn-icon api-link"
                                href="{{ 'api/admin/servicestatus/incident_delete'|link({ 'id': incident.id, 'CSRFToken': CSRFToken }) }}"
                                data-api-confirm="{{ 'Are you sure?'|trans }}"
                                data-api-redirect="{{ 'servicestatus'|alink }}">
                                <svg class="icon">
                                    <use xlink:href="#delete" />
                                </svg>
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td class="text-muted" colspan="6">{{ 'No incidents reported yet'|trans }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# New Component Tab #}
        <div class="tab-pane fade" id="tab-new-component" role="tabpanel">
            <div class="card-body">
                <form method="post" action="{{ 'api/admin/servicestatus/component_create'|link }}" class="api-form" data-api-redirect="{{ 'servicestatus'|alink }}">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Name'|trans }}:</label>
                        <div class="col">
                            <input class="form-control" type="text" name="name" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Description'|trans }}:</label>
                        <div class="col">
                            <textarea class="form-control" name="description" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Status'|trans }}:</label>
                        <div class="col">
                            <select class="form-select" name="status">
                                {% set statuses = admin.servicestatus_statuses %}
                                {% for key, label in statuses %}
                                    <option value="{{ key }}" {{ key == 'operational' ? 'selected' : '' }}>{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Display Order'|trans }}:</label>
                        <div class="col">
                            <input class="form-control" type="number" name="display_order" value="0">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Visible'|trans }}:</label>
                        <div class="col">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="is_visible" value="1" checked>
                            </div>
                        </div>
                    </div>
                    <input type="submit" value="{{ 'Create Component'|trans }}" class="btn btn-primary w-100">
                </form>
            </div>
        </div>

        {# New Incident Tab #}
        <div class="tab-pane fade" id="tab-new-incident" role="tabpanel">
            <div class="card-body">
                <form method="post" action="{{ 'api/admin/servicestatus/incident_create'|link }}" class="api-form" data-api-redirect="{{ 'servicestatus'|alink }}">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Title'|trans }}:</label>
                        <div class="col">
                            <input class="form-control" type="text" name="title" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Status'|trans }}:</label>
                        <div class="col">
                            <select class="form-select" name="status">
                                {% set incident_statuses = admin.servicestatus_incident_statuses %}
                                {% for key, label in incident_statuses %}
                                    <option value="{{ key }}">{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Impact'|trans }}:</label>
                        <div class="col">
                            <select class="form-select" name="impact">
                                {% set statuses = admin.servicestatus_statuses %}
                                {% for key, label in statuses %}
                                    {% if key != 'operational' %}
                                        <option value="{{ key }}" {{ key == 'partial_outage' ? 'selected' : '' }}>{{ label|trans }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Affected Components'|trans }}:</label>
                        <div class="col">
                            {% set components = admin.servicestatus_component_list %}
                            {% for component in components %}
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="components[]" value="{{ component.id }}" id="comp_{{ component.id }}">
                                    <label class="form-check-label" for="comp_{{ component.id }}">{{ component.name }}</label>
                                </div>
                            {% else %}
                                <p class="text-muted">{{ 'No components available. Create components first.'|trans }}</p>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Message'|trans }}:</label>
                        <div class="col">
                            <textarea class="form-control" name="message" rows="4" placeholder="{{ 'Initial update message...'|trans }}"></textarea>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Scheduled At'|trans }}:</label>
                        <div class="col">
                            <input class="form-control" type="datetime-local" name="scheduled_at">
                            <small class="form-hint">{{ 'Only for scheduled maintenance'|trans }}</small>
                        </div>
                    </div>
                    <input type="submit" value="{{ 'Create Incident'|trans }}" class="btn btn-primary w-100">
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
