{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'system' %}

{% block meta_title %}{{ 'Edit Incident'|trans }}{% endblock %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ '/'|alink }}">{{ 'Home'|trans }}</a></li>
        <li class="breadcrumb-item"><a href="{{ '/servicestatus'|alink }}">{{ 'Service Status'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ incident.title }}</li>
    </ol>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">{{ 'Edit Incident'|trans }}</h3>
            </div>
            <div class="card-body">
                <form method="post" action="{{ 'api/admin/servicestatus/incident_update'|link }}" class="api-form" data-api-reload="1">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <input type="hidden" name="id" value="{{ incident.id }}"/>

                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Title'|trans }}:</label>
                        <div class="col">
                            <input class="form-control" type="text" name="title" value="{{ incident.title }}" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Status'|trans }}:</label>
                        <div class="col">
                            <select class="form-select" name="status">
                                {% set incident_statuses = admin.servicestatus_incident_statuses %}
                                {% for key, label in incident_statuses %}
                                    <option value="{{ key }}" {{ incident.status == key ? 'selected' : '' }}>{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Impact'|trans }}:</label>
                        <div class="col">
                            <select class="form-select" name="impact">
                                {% set statuses = admin.servicestatus_statuses %}
                                {% for key, label in statuses %}
                                    {% if key != 'operational' %}
                                        <option value="{{ key }}" {{ incident.impact == key ? 'selected' : '' }}>{{ label|trans }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Affected Components'|trans }}:</label>
                        <div class="col">
                            {% set components = admin.servicestatus_component_list %}
                            {% set affected_ids = [] %}
                            {% for c in incident.components %}
                                {% set affected_ids = affected_ids|merge([c.id]) %}
                            {% endfor %}
                            {% for component in components %}
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="components[]" value="{{ component.id }}" id="comp_{{ component.id }}" {{ component.id in affected_ids ? 'checked' : '' }}>
                                    <label class="form-check-label" for="comp_{{ component.id }}">{{ component.name }}</label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Scheduled At'|trans }}:</label>
                        <div class="col">
                            <input class="form-control" type="datetime-local" name="scheduled_at" value="{{ incident.scheduled_at ? incident.scheduled_at|date('Y-m-d\\TH:i') : '' }}">
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <div class="col offset-3">
                            <input type="submit" value="{{ 'Update Incident'|trans }}" class="btn btn-primary">
                            <a href="{{ 'servicestatus'|alink }}" class="btn">{{ 'Back'|trans }}</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        {# Add Update Form #}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'Add Update'|trans }}</h3>
            </div>
            <div class="card-body">
                <form method="post" action="{{ 'api/admin/servicestatus/incident_update_add'|link }}" class="api-form" data-api-reload="1">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <input type="hidden" name="incident_id" value="{{ incident.id }}"/>

                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Status'|trans }}:</label>
                        <div class="col">
                            <select class="form-select" name="status">
                                {% set incident_statuses = admin.servicestatus_incident_statuses %}
                                {% for key, label in incident_statuses %}
                                    <option value="{{ key }}" {{ incident.status == key ? 'selected' : '' }}>{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="form-label col-3 col-form-label">{{ 'Message'|trans }}:</label>
                        <div class="col">
                            <textarea class="form-control" name="message" rows="4" required></textarea>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <div class="col offset-3">
                            <input type="submit" value="{{ 'Post Update'|trans }}" class="btn btn-primary">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'Update History'|trans }}</h3>
            </div>
            <div class="card-body">
                {% if incident.updates|length > 0 %}
                    <div class="list-group list-group-flush">
                        {% for update in incident.updates %}
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <strong>
                                        {% if update.status == 'investigating' %}
                                            <span class="text-warning">{{ 'Investigating'|trans }}</span>
                                        {% elseif update.status == 'identified' %}
                                            <span class="text-info">{{ 'Identified'|trans }}</span>
                                        {% elseif update.status == 'monitoring' %}
                                            <span class="text-primary">{{ 'Monitoring'|trans }}</span>
                                        {% elseif update.status == 'resolved' %}
                                            <span class="text-success">{{ 'Resolved'|trans }}</span>
                                        {% elseif update.status == 'scheduled' %}
                                            <span class="text-secondary">{{ 'Scheduled'|trans }}</span>
                                        {% endif %}
                                    </strong>
                                    <small class="text-muted">{{ update.created_at|format_datetime }}</small>
                                </div>
                                <p class="mb-1 mt-2">{{ update.message }}</p>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted">{{ 'No updates yet'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
