{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'extensions' %}

{% block meta_title %}{{ 'Edit Incident'|trans }} - {{ incident.title }}{% endblock %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|alink }}">
                <svg class="icon">
                    <use xlink:href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'servicestatus'|alink }}">{{ 'Service Status'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ incident.title|truncate(30) }}</li>
    </ol>
{% endblock %}

{% block content %}
    {% set statuses = admin.servicestatus_get_incident_statuses %}
    {% set all_components = admin.servicestatus_component_get_list %}

    <div class="row">
        <div class="col-md-8">
            {# Incident Details Card #}
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        {% if incident.is_scheduled %}
                            <svg class="icon me-2">
                                <use xlink:href="#tool" />
                            </svg>
                            {{ 'Scheduled Maintenance'|trans }}
                        {% else %}
                            <svg class="icon me-2">
                                <use xlink:href="#alert-circle" />
                            </svg>
                            {{ 'Incident'|trans }}
                        {% endif %}
                    </h3>
                    <div class="card-actions">
                        <span class="badge bg-{% if incident.is_resolved %}success{% else %}warning{% endif %}">
                            {{ incident.status_label }}
                        </span>
                    </div>
                </div>

                <form method="post" action="{{ 'api/admin/servicestatus/incident_update'|link }}" class="api-form" data-api-msg="{{ 'Incident updated successfully'|trans }}">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
                    <input type="hidden" name="id" value="{{ incident.id }}">

                    <div class="card-body">
                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label">{{ 'Title'|trans }} *</label>
                            <div class="col-md-9">
                                <input class="form-control" type="text" name="title" value="{{ incident.title }}" required>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label">{{ 'Status'|trans }}</label>
                            <div class="col-md-9">
                                <select class="form-select" name="status">
                                    {% for key, label in statuses %}
                                        <option value="{{ key }}" {% if key == incident.status %}selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label">{{ 'Impact'|trans }}</label>
                            <div class="col-md-9">
                                <select class="form-select" name="impact">
                                    <option value="none" {% if incident.impact == 'none' %}selected{% endif %}>{{ 'None'|trans }}</option>
                                    <option value="minor" {% if incident.impact == 'minor' %}selected{% endif %}>{{ 'Minor'|trans }}</option>
                                    <option value="major" {% if incident.impact == 'major' %}selected{% endif %}>{{ 'Major'|trans }}</option>
                                    <option value="critical" {% if incident.impact == 'critical' %}selected{% endif %}>{{ 'Critical'|trans }}</option>
                                </select>
                            </div>
                        </div>

                        {% if incident.is_scheduled %}
                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label">{{ 'Scheduled For'|trans }}</label>
                            <div class="col-md-4">
                                <input class="form-control" type="datetime-local" name="scheduled_for" value="{{ incident.scheduled_for|date('Y-m-d\\TH:i') }}">
                                <small class="form-hint">{{ 'Start time'|trans }}</small>
                            </div>
                            <div class="col-md-4">
                                <input class="form-control" type="datetime-local" name="scheduled_until" value="{{ incident.scheduled_until|date('Y-m-d\\TH:i') }}">
                                <small class="form-hint">{{ 'End time'|trans }}</small>
                            </div>
                        </div>
                        {% endif %}

                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label">{{ 'Affected Components'|trans }}</label>
                            <div class="col-md-9">
                                {% set affected_ids = [] %}
                                {% for comp in incident.components %}
                                    {% set affected_ids = affected_ids|merge([comp.id]) %}
                                {% endfor %}

                                {% for comp in all_components %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="component_ids[]" value="{{ comp.id }}" id="comp_{{ comp.id }}" {% if comp.id in affected_ids %}checked{% endif %}>
                                        <label class="form-check-label" for="comp_{{ comp.id }}">{{ comp.name }}</label>
                                    </div>
                                {% else %}
                                    <span class="text-muted">{{ 'No components available.'|trans }}</span>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label">{{ 'Created'|trans }}</label>
                            <div class="col-md-9">
                                <input class="form-control" type="text" value="{{ incident.created_at|format_datetime }}" disabled>
                            </div>
                        </div>

                        {% if incident.resolved_at %}
                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label">{{ 'Resolved'|trans }}</label>
                            <div class="col-md-9">
                                <input class="form-control" type="text" value="{{ incident.resolved_at|format_datetime }}" disabled>
                            </div>
                        </div>
                        {% endif %}
                    </div>

                    <div class="card-footer d-flex gap-2">
                        <a href="{{ 'servicestatus'|alink }}" class="btn btn-secondary">
                            <svg class="icon me-1">
                                <use xlink:href="#arrow-left" />
                            </svg>
                            {{ 'Back'|trans }}
                        </a>
                        <button class="btn btn-primary flex-grow-1" type="submit">
                            <svg class="icon me-1">
                                <use xlink:href="#check" />
                            </svg>
                            {{ 'Update Incident'|trans }}
                        </button>
                        <a class="btn btn-danger api-link"
                           href="{{ 'api/admin/servicestatus/incident_delete'|link({'id': incident.id, 'CSRFToken': CSRFToken}) }}"
                           data-api-confirm="{{ 'Are you sure you want to delete this incident?'|trans }}"
                           data-api-redirect="{{ 'servicestatus'|alink }}">
                            <svg class="icon me-1">
                                <use xlink:href="#delete" />
                            </svg>
                            {{ 'Delete'|trans }}
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-4">
            {# Add Update Card #}
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">{{ 'Post Update'|trans }}</h3>
                </div>
                <form method="post" action="{{ 'api/admin/servicestatus/incident_add_update'|link }}" class="api-form" data-api-reload="true">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
                    <input type="hidden" name="incident_id" value="{{ incident.id }}">

                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">{{ 'Status'|trans }}</label>
                            <select class="form-select" name="status" required>
                                {% for key, label in statuses %}
                                    <option value="{{ key }}" {% if key == incident.status %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">{{ 'Message'|trans }} *</label>
                            <textarea class="form-control" name="message" rows="4" required placeholder="{{ 'Describe the current situation or progress...'|trans }}"></textarea>
                        </div>
                    </div>

                    <div class="card-footer">
                        <button class="btn btn-primary w-100" type="submit">
                            <svg class="icon me-1">
                                <use xlink:href="#plus" />
                            </svg>
                            {{ 'Post Update'|trans }}
                        </button>
                    </div>
                </form>
            </div>

            {# Updates Timeline #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ 'Update History'|trans }}</h3>
                </div>
                <div class="card-body">
                    {% if incident.updates|length > 0 %}
                        <ul class="timeline">
                            {% for update in incident.updates %}
                            <li class="timeline-event">
                                <div class="timeline-event-icon bg-{% if update.status == 'resolved' %}success{% elseif update.status == 'monitoring' %}info{% else %}warning{% endif %}">
                                    <svg class="icon">
                                        {% if update.status == 'resolved' %}
                                            <use xlink:href="#check" />
                                        {% elseif update.status == 'monitoring' %}
                                            <use xlink:href="#eye" />
                                        {% elseif update.status == 'identified' %}
                                            <use xlink:href="#search" />
                                        {% else %}
                                            <use xlink:href="#alert-circle" />
                                        {% endif %}
                                    </svg>
                                </div>
                                <div class="card timeline-event-card">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="badge bg-secondary">{{ update.status_label }}</span>
                                            <small class="text-muted">{{ update.created_at|format_datetime }}</small>
                                        </div>
                                        <p class="mb-0">{{ update.message }}</p>
                                    </div>
                                </div>
                            </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted text-center">{{ 'No updates yet.'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block head %}
<style>
.timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
}
.timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--tblr-border-color);
}
.timeline-event {
    position: relative;
    padding-left: 45px;
    margin-bottom: 1rem;
}
.timeline-event:last-child {
    margin-bottom: 0;
}
.timeline-event-icon {
    position: absolute;
    left: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}
.timeline-event-icon .icon {
    width: 16px;
    height: 16px;
}
.timeline-event-card {
    box-shadow: none;
    border: 1px solid var(--tblr-border-color);
}
</style>
{% endblock %}
