{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'extensions' %}

{% block meta_title %}{{ 'Edit Component'|trans }} - {{ component.name }}{% endblock %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|alink }}">
                <svg class="icon">
                    <use xlink:href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'servicestatus'|alink }}">{{ 'Service Status'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">{{ component.name }}</li>
    </ol>
{% endblock %}

{% block content %}
    {% set statuses = admin.servicestatus_get_statuses %}

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <svg class="icon me-2">
                    <use xlink:href="#server" />
                </svg>
                {{ 'Edit Component'|trans }}: {{ component.name }}
            </h3>
            <div class="card-actions">
                <span class="badge bg-{{ component.status_color }}">{{ component.status_label }}</span>
            </div>
        </div>

        <form method="post" action="{{ 'api/admin/servicestatus/component_update'|link }}" class="api-form" data-api-msg="{{ 'Component updated successfully'|trans }}">
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
            <input type="hidden" name="id" value="{{ component.id }}">

            <div class="card-body">
                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Component Name'|trans }} *</label>
                    <div class="col-md-6">
                        <input class="form-control" type="text" name="name" value="{{ component.name }}" required>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Description'|trans }}</label>
                    <div class="col-md-6">
                        <textarea class="form-control" name="description" rows="2">{{ component.description }}</textarea>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Group'|trans }}</label>
                    <div class="col-md-6">
                        <input class="form-control" type="text" name="group_name" value="{{ component.group_name }}">
                        <small class="form-hint">{{ 'Components with the same group name will be displayed together.'|trans }}</small>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Status'|trans }}</label>
                    <div class="col-md-6">
                        <select class="form-select" name="status">
                            {% for key, label in statuses %}
                                <option value="{{ key }}" {% if key == component.status %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Display Order'|trans }}</label>
                    <div class="col-md-6">
                        <input class="form-control" type="number" name="display_order" value="{{ component.display_order }}">
                        <small class="form-hint">{{ 'Lower numbers are displayed first.'|trans }}</small>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Visible to Public'|trans }}</label>
                    <div class="col-md-6">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="is_visible" id="visible_yes" value="1" {% if component.is_visible %}checked{% endif %}>
                            <label class="form-check-label" for="visible_yes">{{ 'Yes'|trans }}</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="is_visible" id="visible_no" value="0" {% if not component.is_visible %}checked{% endif %}>
                            <label class="form-check-label" for="visible_no">{{ 'No'|trans }}</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Created'|trans }}</label>
                    <div class="col-md-6">
                        <input class="form-control" type="text" value="{{ component.created_at|format_datetime }}" disabled>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-md-3 col-form-label">{{ 'Last Updated'|trans }}</label>
                    <div class="col-md-6">
                        <input class="form-control" type="text" value="{{ component.updated_at|format_datetime }}" disabled>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex gap-2">
                <a href="{{ 'servicestatus'|alink }}" class="btn btn-secondary">
                    <svg class="icon me-1">
                        <use xlink:href="#arrow-left" />
                    </svg>
                    {{ 'Back'|trans }}
                </a>
                <button class="btn btn-primary flex-grow-1" type="submit">
                    <svg class="icon me-1">
                        <use xlink:href="#check" />
                    </svg>
                    {{ 'Update Component'|trans }}
                </button>
                <a class="btn btn-danger api-link"
                   href="{{ 'api/admin/servicestatus/component_delete'|link({'id': component.id, 'CSRFToken': CSRFToken}) }}"
                   data-api-confirm="{{ 'Are you sure you want to delete this component?'|trans }}"
                   data-api-redirect="{{ 'servicestatus'|alink }}">
                    <svg class="icon me-1">
                        <use xlink:href="#delete" />
                    </svg>
                    {{ 'Delete'|trans }}
                </a>
            </div>
        </form>
    </div>
{% endblock %}
