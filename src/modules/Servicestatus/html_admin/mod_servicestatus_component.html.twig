{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'system' %}

{% block meta_title %}{{ 'Edit Component'|trans }}{% endblock %}

{% block breadcrumbs %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ '/'|alink }}">{{ 'Home'|trans }}</a></li>
        <li class="breadcrumb-item"><a href="{{ '/servicestatus'|alink }}">{{ 'Service Status'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ component.name }}</li>
    </ol>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'Edit Component'|trans }}: {{ component.name }}</h3>
    </div>
    <div class="card-body">
        <form method="post" action="{{ 'api/admin/servicestatus/component_update'|link }}" class="api-form" data-api-redirect="{{ 'servicestatus'|alink }}">
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
            <input type="hidden" name="id" value="{{ component.id }}"/>

            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'Name'|trans }}:</label>
                <div class="col">
                    <input class="form-control" type="text" name="name" value="{{ component.name }}" required>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'Description'|trans }}:</label>
                <div class="col">
                    <textarea class="form-control" name="description" rows="3">{{ component.description }}</textarea>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'Status'|trans }}:</label>
                <div class="col">
                    <select class="form-select" name="status">
                        {% set statuses = admin.servicestatus_statuses %}
                        {% for key, label in statuses %}
                            <option value="{{ key }}" {{ component.status == key ? 'selected' : '' }}>{{ label|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'Display Order'|trans }}:</label>
                <div class="col">
                    <input class="form-control" type="number" name="display_order" value="{{ component.display_order }}">
                </div>
            </div>
            <div class="mb-3 row">
                <label class="form-label col-3 col-form-label">{{ 'Visible'|trans }}:</label>
                <div class="col">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="is_visible" value="1" {{ component.is_visible ? 'checked' : '' }}>
                    </div>
                </div>
            </div>

            <div class="mb-3 row">
                <div class="col offset-3">
                    <input type="submit" value="{{ 'Update Component'|trans }}" class="btn btn-primary">
                    <a href="{{ 'servicestatus'|alink }}" class="btn">{{ 'Cancel'|trans }}</a>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
